#!/usr/bin/env python3
# Claude Code's status line (config/agents/claude.json): the model, how full
# the context is, and the plan's usage, five-hourly and weekly, with when each
# resets. Claude Code passes the session as JSON on stdin; colours are the
# terminal's own, so the palette's (theme/foot).
import json, sys, time

session = json.load(sys.stdin)
dim, reset = "\033[2m", "\033[0m"


def level(percent):
    # Green, yellow from half, red from 80%: the palette's ANSI colours.
    colour = 31 if percent >= 80 else 33 if percent >= 50 else 32
    return f"\033[{colour}m{percent:.0f}%{reset}"


def when(at):
    if isinstance(at, str):
        try:
            at = time.mktime(time.strptime(at[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone
        except ValueError:
            return ""
    if not isinstance(at, (int, float)):
        return ""
    if at > 1e12:
        at /= 1000
    left = at - time.time()
    if left <= 0:
        return ""
    hours, minutes = divmod(int(left // 60), 60)
    return f"{dim} {hours // 24}d{reset}" if hours >= 24 else f"{dim} {hours}h{minutes:02d}{reset}"


parts = [(session.get("model") or {}).get("display_name") or "Claude"]
context = (session.get("context_window") or {}).get("used_percentage")
if isinstance(context, (int, float)):
    parts.append(f"{dim}context{reset} {level(context)}")
limits = session.get("rate_limits") or {}
for key, name in (("five_hour", "5h"), ("seven_day", "week")):
    limit = limits.get(key) or {}
    used = limit.get("used_percentage")
    if isinstance(used, (int, float)):
        parts.append(f"{dim}{name}{reset} {level(used)}{when(limit.get('resets_at'))}")
print("   ".join(parts))
