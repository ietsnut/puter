#!/bin/bash
# puter-secret: tokens and keys for puter's tools (filigree's JLC API, ...),
# kept in secrets.age at the top of this repo, encrypted with age to the key
# in secrets.pub. The key that opens them is only ever on the machines, in
# ~/.config/puter/age.key, never in the repo: a new puter gets it from one
# that has it (key-from), over SSH.
#
#   puter-secret list              the secrets' names
#   puter-secret get NAME          one secret's value
#   puter-secret set NAME [VALUE]  sets one (VALUE, or a line from stdin)
#   puter-secret unset NAME        takes one out
#   puter-secret key-from HOST     copies the key from another puter
#                                  (e.g. puter.local) to this one
#   puter-secret init              makes the key, on the first machine only
#
# Names are LIKE_THIS; values are one line each. Commit secrets.age after
# set or unset, as any other change.
set -euo pipefail
repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
file="$repo/secrets.age"
pub="$repo/secrets.pub"
key="$HOME/.config/puter/age.key"

die() { echo "puter-secret: $*" >&2; exit 1; }

need_key() {
	[ -f "$key" ] || die "no key at $key: copy it from another puter (puter-secret key-from puter.local), or make the first (init)"
}

open_all() {
	need_key
	if [ -f "$file" ]; then age -d -i "$key" "$file"; fi
}

seal() {
	[ -f "$pub" ] || die "no $pub"
	local tmp="$file.tmp"
	age -r "$(cat "$pub")" -o "$tmp"
	mv "$tmp" "$file"
}

check_name() {
	[[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "a name is LIKE_THIS, not '$1'"
}

case "${1:-}" in
list)
	open_all | sed -n 's/=.*//p'
	;;
get)
	check_name "${2:-}"
	line=$(open_all | grep -m1 "^$2=") || die "no secret $2"
	printf '%s\n' "${line#*=}"
	;;
set)
	check_name "${2:-}"
	if [ $# -ge 3 ]; then value=$3; else IFS= read -r value; fi
	[ -n "$value" ] || die "no value for $2"
	[[ "$value" != *$'\n'* ]] || die "values are one line"
	{ open_all | grep -v "^$2=" || true; printf '%s=%s\n' "$2" "$value"; } | seal
	echo "set $2"
	;;
unset)
	check_name "${2:-}"
	{ open_all | grep -v "^$2=" || true; } | seal
	echo "took $2 out"
	;;
key-from)
	[ -n "${2:-}" ] || die "key-from needs a host"
	[ ! -f "$key" ] || die "there's a key here already ($key)"
	mkdir -p "$(dirname "$key")"
	(umask 077; ssh "$2" cat .config/puter/age.key > "$key.tmp")
	age-keygen -y "$key.tmp" | grep -qx "$(cat "$pub")" || { rm -f "$key.tmp"; die "$2's key doesn't open secrets.age"; }
	mv "$key.tmp" "$key"
	echo "the key is here"
	;;
init)
	[ ! -f "$key" ] || die "there's a key here already ($key)"
	[ ! -f "$pub" ] || die "secrets.pub is there: this puter needs the existing key (key-from), not a new one"
	mkdir -p "$(dirname "$key")"
	(umask 077; age-keygen -o "$key" 2>/dev/null)
	age-keygen -y "$key" > "$pub"
	echo "made $key; commit secrets.pub"
	;;
*)
	sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
	exit 2
	;;
esac
