#!/usr/bin/env python3
"""The lock screen's code (config/quickshell/Lock.qml): numbers only, kept
on this machine alone, hashed (scrypt), in ~/.local/state/puter/lock.code.
Codes come on stdin, never as arguments. While the screen is locked,
~/.local/state/puter/locked exists, so a restarted shell locks again.

  puter-lock has            exits 0 if a code is set
  puter-lock set            the code on stdin becomes the code
  puter-lock check          exits 0 if the code on stdin is it
  puter-lock mark on|off    the screen is locked, or isn't
  puter-lock marked         exits 0 if it is

To choose a new code, delete ~/.local/state/puter/lock.code: the next lock
asks for one.
"""
import hashlib
import hmac
import os
import sys
import time

state = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "puter")
code_file = os.path.join(state, "lock.code")
marker = os.path.join(state, "locked")


def digest(code, salt):
    return hashlib.scrypt(code.encode(), salt=salt, n=2 ** 14, r=8, p=1)


def read_code():
    code = sys.stdin.read().strip()
    if not code.isdigit():
        sys.exit("Numbers only")
    return code


def main(args):
    what = args[0] if args else ""
    if what == "has":
        sys.exit(0 if os.path.exists(code_file) else 1)
    elif what == "set":
        code = read_code()
        salt = os.urandom(16)
        os.makedirs(state, exist_ok=True)
        fd = os.open(code_file + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(salt.hex() + " " + digest(code, salt).hex() + "\n")
        os.replace(code_file + ".new", code_file)
    elif what == "check":
        code = read_code()
        try:
            salt, want = open(code_file).read().split()
        except (OSError, ValueError):
            sys.exit("No code set")
        if hmac.compare_digest(digest(code, bytes.fromhex(salt)).hex(), want):
            return
        # A wrong code waits a second: guessing takes a while.
        time.sleep(1)
        sys.exit(1)
    elif what == "mark" and len(args) == 2 and args[1] in ("on", "off"):
        os.makedirs(state, exist_ok=True)
        if args[1] == "on":
            open(marker, "w").close()
        elif os.path.exists(marker):
            os.unlink(marker)
    elif what == "marked":
        sys.exit(0 if os.path.exists(marker) else 1)
    else:
        sys.exit(__doc__)


main(sys.argv[1:])
