#!/bin/bash
# puter's look, light or dark, for the whole machine (the bar's sun and moon
# button): theme/ or theme/dark/, both written by theme/make.
#
#   puter-mode           which it is now
#   puter-mode light     light
#   puter-mode dark      dark
#   puter-mode toggle    the other one
#
# The choice is ~/.config/puter/mode, which the shell follows as it changes
# (config/quickshell/Colors.qml); install.sh look points everything else at
# the look, and labwc reloads its theme. GTK apps change at once; Qt apps,
# Firefox, Thunderbird and the terminals once opened again.
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
file="$HOME/.config/puter/mode"

now="$(cat "$file" 2>/dev/null || true)"
[[ $now == dark ]] || now=light
case "${1:-}" in
  "") echo "$now"; exit ;;
  light | dark) want=$1 ;;
  toggle) want=$([[ $now == dark ]] && echo light || echo dark) ;;
  *) echo "usage: puter-mode [light|dark|toggle]" >&2; exit 1 ;;
esac

mkdir -p "$(dirname "$file")"
echo "$want" >"$file"
"$repo/install.sh" look
pkill -HUP -x labwc || true
qs ipc call look changed >/dev/null 2>&1 || true
