#!/usr/bin/env python3
"""The desk's file work (config/quickshell/Desk.qml), on ~/Desktop and the
folders on it. Nothing is ever overwritten: a name that's taken gets a number
("notes 2.txt"), as on a Mac.

  puter-desk move DEST SRC...     into the folder DEST; prints the new names
  puter-desk copy DEST SRC...     the same, copying
  puter-desk rename PATH NAME     fails if NAME is taken
  puter-desk new-folder DIR       "untitled folder"; prints its name
  puter-desk delete PATH...       for good: there's no trash
"""
import os
import shutil
import sys


def free(folder, name):
    """name in folder, or the first "name N" (before the extension) that's free."""
    if not os.path.lexists(os.path.join(folder, name)):
        return name
    stem, ext = os.path.splitext(name)
    if stem == "" or os.path.isdir(os.path.join(folder, name)):
        stem, ext = name, ""
    n = 2
    while os.path.lexists(os.path.join(folder, f"{stem} {n}{ext}")):
        n += 1
    return f"{stem} {n}{ext}"


def bring(dest, sources, copy):
    dest = os.path.realpath(dest)
    for src in sources:
        src = os.path.abspath(src)
        if not os.path.lexists(src):
            continue
        real = os.path.realpath(src)
        # Not into itself or where it already is.
        if dest == real or dest.startswith(real + os.sep):
            continue
        if not copy and os.path.dirname(real) == dest:
            continue
        name = free(dest, os.path.basename(src.rstrip(os.sep)))
        target = os.path.join(dest, name)
        if copy:
            if os.path.isdir(src) and not os.path.islink(src):
                shutil.copytree(src, target, symlinks=True)
            else:
                shutil.copy2(src, target, follow_symlinks=False)
        else:
            shutil.move(src, target)
        print(name, flush=True)


def main(args):
    if not args:
        sys.exit(__doc__)
    what, rest = args[0], args[1:]
    if what in ("move", "copy") and len(rest) >= 2:
        bring(rest[0], rest[1:], what == "copy")
    elif what == "rename" and len(rest) == 2:
        path, name = rest
        name = name.strip()
        if not name or "/" in name or name in (".", ".."):
            sys.exit("Not a name")
        target = os.path.join(os.path.dirname(path), name)
        if target == path:
            return
        # Only the case changing is the same file, and fine.
        if os.path.lexists(target) and not os.path.samefile(path, target):
            sys.exit(f"“{name}” is taken")
        os.rename(path, target)
        print(name)
    elif what == "new-folder" and len(rest) == 1:
        name = free(rest[0], "untitled folder")
        os.mkdir(os.path.join(rest[0], name))
        print(name)
    elif what == "delete" and rest:
        for path in rest:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            elif os.path.lexists(path):
                os.unlink(path)
    else:
        sys.exit(__doc__)


main(sys.argv[1:])
