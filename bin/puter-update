#!/bin/bash
# Updates everything on puter to the newest there is, in one go:
#
#   1. Arch and puter's own packages: the keyring first, then every package
#      (the kernel, firmware files, the apps, Codex), and any package puter
#      has added to packages.txt since. puter's own (labwc and qps patched,
#      wlrctl, qpdfview, JLCONE, and its apps from src/) come from its pacman
#      repository, [puter], which CI builds and signs (packages/build)
#   2. firmware, through fwupd (the machine's own: disks, the BIOS, docks)
#   3. puter itself, from its git remote, when this checkout has one
#   4. Claude Code, through its own updater
#   5. puter's settings, applied again (install.sh config)
#
#   puter-update          all of it (through sudo, which on puter never asks
#                         for a password: install.sh's access)
#   puter-update check    what's out of date, a line each: what, tab, by how much
#   puter-update repo     only trust and list [puter] (what the USB installer,
#                         iso/, runs offline on the new disk)
#   puter-update packages [ARCH]
#                         what packages.txt says to install on this machine's
#                         architecture (or ARCH's), a name a line
#
# The bar's update button (config/quickshell/Updates.qml) runs
# `sudo puter-update run` and follows lines starting with "::":
#   ::step 4 5 Claude Code  a step begins
#   ::fail Claude Code         a step failed (the others still run)
#   ::restart             something running (the kernel, labwc, the shell) changed
#   ::done                finished
# Everything else is the steps' own output, also kept in
# ~/.local/state/puter/update.log.
set -uo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# What, upgraded, wants a restart to take effect.
running=(linux linux-lts linux-zen linux-hardened systemd glibc mesa labwc quickshell qt6-base wlroots0.20)

# What's out of date, without changing anything (and without root): the
# packages through checkupdates (a copy of the sync database), puter's own
# listed apart from Arch's, and the rest by asking upstream.
count_line() { # label updates (checkupdates' lines)
  local count names_
  count="$(grep -c . <<<"$2")"
  ((count > 0)) || return 0
  names_="$(awk '{print $1}' <<<"$2" | head -3 | paste -sd, - | sed 's/,/, /g')"
  ((count > 3)) && names_+=" and $((count - 3)) more"
  printf '%s\t%s package%s: %s\n' "$1" "$count" "$([[ $count == 1 ]] || echo s)" "$names_"
}

check() {
  local updates ours count have want
  updates="$(checkupdates 2>/dev/null)"
  ours="$(pacman -Slq puter 2>/dev/null | paste -sd'|' -)"
  count_line "Arch Linux" "$(grep -v -E "^(${ours:-^}) " <<<"$updates")"
  count_line "puter's packages" "$(grep -E "^(${ours:-^}) " <<<"$updates")"

  if command -v fwupdmgr >/dev/null; then
    count="$(timeout 20 fwupdmgr get-updates --json 2>/dev/null | python3 -c '
import json, sys
try: print(len(json.load(sys.stdin).get("Devices", [])))
except Exception: print(0)')"
    ((count > 0)) && printf 'Firmware\t%s device%s\n' "$count" "$([[ $count == 1 ]] || echo s)"
  fi

  if git -C "$repo" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    timeout 20 git -C "$repo" fetch -q 2>/dev/null
    count="$(git -C "$repo" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
    ((count > 0)) && printf 'puter\t%s new change%s\n' "$count" "$([[ $count == 1 ]] || echo s)"
  fi

  local claude="$HOME/.local/bin/claude"
  if [[ -x $claude ]]; then
    have="$("$claude" --version 2>/dev/null | awk '{print $1}')"
    want="$(curl -fsSL --max-time 20 https://registry.npmjs.org/@anthropic-ai/claude-code/latest |
      python3 -c 'import json, sys; print(json.load(sys.stdin)["version"])' 2>/dev/null)"
    [[ -n $want && $(vercmp "$have" "$want") -lt 0 ]] && printf 'Claude Code\t%s → %s\n' "$have" "$want"
  fi
  true
}

# Everything below runs as root, with the user who asked (sudo's) for what
# mustn't: git, Claude Code and the settings.
as_user() {
  runuser -u "$user" -- env HOME="$home" USER="$user" LOGNAME="$user" \
    XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
    PATH="$home/.local/bin:/usr/local/bin:/usr/bin" LANG="${LANG:-C.UTF-8}" "$@"
}

step=0
steps=0
failed=()
begin() {
  step=$((step + 1))
  echo "::step $step $steps $1"
  echo "== $1"
}
fail() {
  failed+=("$1")
  echo "::fail $1"
  echo "!! $1 failed"
}

# What packages.txt says to install on an architecture: every package
# that names none, and those that name it.
packages() { # [arch]
  local arch="${1:-$(uname -m)}"
  sed 's/#.*//' "$repo/packages.txt" | awk -v arch="$arch" 'NF == 1 || (NF > 1 && index(" " $0 " ", " " arch " ")) {print $1}'
}

# puter's pacman repository, [puter]: built and signed by CI
# (packages/build), trusted through puter's key (packages/puter.gpg, taken
# again each time, so a new key only needs committing) and listed before
# Arch's own, so its labwc and qps, patched, are the ones installed.
puter_repo() {
  pacman-key --add "$repo/packages/puter.gpg" >/dev/null || return 1
  pacman-key --lsign-key "$(gpg --with-colons --show-keys "$repo/packages/puter.gpg" |
    awk -F: '/^fpr/ {print $10; exit}')" >/dev/null || return 1
  grep -q '^\[puter\]' /etc/pacman.conf ||
    sed -i "/^\\[core\\]/i [puter]\\nSigLevel = Required\\nServer = $(repo_url)\\n" /etc/pacman.conf
}

# Where [puter] is for this machine: the release "repo" for x86_64,
# "repo-aarch64" for Arch Linux ARM.
repo_url() {
  local release=repo
  [[ $(uname -m) == x86_64 ]] || release="repo-$(uname -m)"
  echo "https://github.com/ietsnut/puter/releases/download/$release"
}

system() {
  begin "Arch Linux"
  puter_repo || return 1
  local keyring=archlinux-keyring
  [[ $(uname -m) == x86_64 ]] || keyring=archlinuxarm-keyring
  pacman -Sy --needed --noconfirm "$keyring" || return 1
  # Everything in packages.txt, so what puter has added since is installed.
  local pkgs overwrite=()
  mapfile -t pkgs < <(packages)
  # puter's apps were once installed by cmake, outside pacman: their files
  # are taken over the first time they come as a package.
  pacman -Q puter-apps >/dev/null 2>&1 || overwrite=(--overwrite '/usr/bin/puter-*'
    --overwrite /usr/lib/qt6/plugins/styles/libputerstyle.so --overwrite '/usr/share/applications/puter-*')
  pacman -Su --needed --noconfirm "${overwrite[@]}" "${pkgs[@]}" || return 1
  # The two newest of each package are kept in pacman's cache.
  if command -v paccache >/dev/null; then paccache -rk2; fi
}

firmware() {
  begin "Firmware"
  if ! command -v fwupdmgr >/dev/null; then
    echo "fwupd isn't installed."
    return 0
  fi
  fwupdmgr refresh --force --assume-yes || true
  # 2: nothing to update.
  fwupdmgr update --assume-yes --no-reboot-check
  local status=$?
  ((status == 0 || status == 2))
}

puter() {
  begin "puter"
  if ! as_user git -C "$repo" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    echo "$repo has no git remote to update from."
    return 0
  fi
  as_user git -C "$repo" pull --ff-only
}

claude() {
  begin "Claude Code"
  if [[ -x $home/.local/bin/claude ]]; then
    as_user "$home/.local/bin/claude" update
  else
    as_user bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
  fi
}

settings() {
  begin "Settings"
  as_user "$repo/install.sh" config
}

run() {
  user="${SUDO_USER:?run puter-update through sudo}"
  home="$(getent passwd "$user" | cut -d: -f6)"
  uid="$(id -u "$user")"
  local log="$home/.local/state/puter/update.log"
  as_user mkdir -p "$(dirname "$log")"
  : >"$log" && chown "$user:" "$log"
  exec > >(tee -a "$log") 2>&1
  local tee=$!
  echo "puter-update, $(date '+%A %-d %B %Y %H:%M')"

  local before after
  before="$(pacman -Q "${running[@]}" 2>/dev/null)"
  steps=5

  # Without the packages, nothing else can be trusted to run.
  if ! system; then
    fail "Arch Linux"
    echo "::done"
    return 1
  fi
  firmware || fail "Firmware"
  puter || fail "puter"
  claude || fail "Claude Code"
  settings || fail "Settings"

  after="$(pacman -Q "${running[@]}" 2>/dev/null)"
  if [[ $before != "$after" || ! -d /usr/lib/modules/$(uname -r) ]]; then
    echo "::restart"
    echo "Restart to finish: $(diff <(echo "$before") <(echo "$after") | awk '/^>/ {print $2}' | paste -sd' ' -)"
  fi
  if ((${#failed[@]})); then
    echo "Done, except: ${failed[*]}. The log: $log"
  else
    echo "Everything is up to date."
  fi
  echo "::done"
  # Waits for the log to have it all, so whoever reads the output does too.
  exec >&- 2>&-
  wait "$tee"
  ((${#failed[@]} == 0))
}

# Read whole before it starts: step 3 may pull a new copy of this file.
main() {
  case "${1:-}" in
    check) check ;;
    run) run ;;
    repo) puter_repo ;;
    packages) packages "${2:-}" ;;
    "") if [[ $EUID -eq 0 ]]; then run; else exec sudo "$0" run; fi ;;
    *) echo "usage: puter-update [check|repo|packages [ARCH]]" >&2; return 1 ;;
  esac
}
main "$@"
exit
