+			}
+		}
+		int top = box->y + row, bottom = box->y + box->height - 1 - row;
+		int left = box->x, right = box->x + box->width - width;
+		if (corners & WLR_SCENE_CORNER_TOP_LEFT) {
+			pixman_region32_union_rect(region, region, left, top, width, 1);
+		}
+		if (corners & WLR_SCENE_CORNER_TOP_RIGHT) {
+			pixman_region32_union_rect(region, region, right, top, width, 1);
+		}
+		if (corners & WLR_SCENE_CORNER_BOTTOM_RIGHT) {
+			pixman_region32_union_rect(region, region, right, bottom, width, 1);
+		}
