+/*
+ * puter: the rounded box of a node's nearest rounded ancestor, for the node
+ * at x, y, with its radius (no more than half its width or height) and
+ * corners; false when there's none.
+ */
+static bool scene_node_rounded(struct wlr_scene_node *node, int x, int y,
+		struct wlr_box *box, int *radius, uint32_t *corners) {
+	for (; node->parent != NULL; node = &node->parent->node) {
+		x -= node->x;
+		y -= node->y;
+		struct wlr_scene_tree *tree = node->parent;
+		if (tree->corners == 0) {
+			continue;
+		}
+		*box = (struct wlr_box){ x, y, tree->width, tree->height };
+		*radius = tree->radius;
+		if (*radius > box->width / 2) {
+			*radius = box->width / 2;
+		}
+		if (*radius > box->height / 2) {
+			*radius = box->height / 2;
+		}
+		*corners = tree->corners;
+		return *radius > 0;
+	}
+	return false;
+}
