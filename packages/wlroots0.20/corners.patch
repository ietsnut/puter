+ * outside each corner's arc, or with whole, its radius-sized square.
+ */
+static void corners_region(pixman_region32_t *region, const struct wlr_box *box,
+		int radius, uint32_t corners, bool whole) {
+	for (int row = 0; row < radius; row++) {
+		int width = radius;
+		if (!whole) {
+			// In half pixels from the arc's centre, compared squared
+			int dy = 2 * (radius - row) - 1;
+			width = 0;
+			while (width < radius && (2 * (radius - width) - 1) * (2 * (radius - width) - 1)
+					+ dy * dy > 4 * radius * radius) {
+				width++;
+			}
+			if (width == 0) {
