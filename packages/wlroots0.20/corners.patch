+		int width, int height, int radius, uint32_t corners) {
+	if (width <= 0 || height <= 0 || radius <= 0 || corners == 0) {
+		width = height = radius = 0;
+		corners = 0;
+	}
+	if (tree->width == width && tree->height == height &&
