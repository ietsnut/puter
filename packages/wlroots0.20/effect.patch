+void wlr_scene_tree_set_effect(struct wlr_scene_tree *tree,
+		float opacity, float scale, int cx, int cy) {
+	bool effect = opacity != 1 || scale != 1;
+	if (!effect && !tree->effect) {
+		return;
+	}
+	assert(scale <= 1);
+	tree->effect = effect;
+	tree->opacity = opacity;
+	tree->scale = scale;
+	tree->cx = cx;
+	tree->cy = cy;
+	scene_node_update(&tree->node, NULL);
