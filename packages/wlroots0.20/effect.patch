+/*
+ * puter: the nearest tree over node with an effect (see
+ * wlr_scene_tree_set_effect()), its opacity, scale and centre in the
+ * coordinates node is at (x, y) in.
+ */
+static bool scene_node_effect(struct wlr_scene_node *node, int x, int y,
+		float *opacity, float *scale, int *cx, int *cy) {
+	for (; node->parent != NULL; node = &node->parent->node) {
+		x -= node->x;
+		y -= node->y;
+		struct wlr_scene_tree *tree = node->parent;
+		if (tree->effect) {
+			*opacity = tree->opacity;
+			*scale = tree->scale;
+			*cx = x + tree->cx;
+			*cy = y + tree->cy;
+			return true;
+		}
+	}
+	return false;
+}
+
+// puter: a box scaled about (cx, cy)
+static void effect_box(struct wlr_box *box, float scale, int cx, int cy) {
+	int right = round(cx + (box->x + box->width - cx) * scale);
+	int bottom = round(cy + (box->y + box->height - cy) * scale);
+	box->x = round(cx + (box->x - cx) * scale);
+	box->y = round(cy + (box->y - cy) * scale);
+	box->width = right - box->x;
+	box->height = bottom - box->y;
+}
