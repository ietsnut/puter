# puter's own apps (src/): its Qt widget style, Sheet, Calculator and
# puter-windows. Built from this checkout, which packages/build copies in
# beside this file as puter-src; its version is Qt's and src/'s commit
# count (packages/build sets it), so a Qt upgrade, which breaks the style
# plugin, rebuilds it as surely as a change to src/ does.
pkgname=puter-apps
pkgver=0
pkgrel=1
pkgdesc="puter's Qt widget style, table editor, calculator and window lister"
arch=('x86_64' 'aarch64')
url="https://github.com/ietsnut/puter"
license=('LicenseRef-puter')
depends=('qt6-base' 'libqalculate' 'wayland')
makedepends=('cmake' 'wayland-protocols')

build() {
  local part
  for part in style sheet calc windows; do
    cmake -S "$startdir/puter-src/$part" -B "$srcdir/$part" \
      -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
    cmake --build "$srcdir/$part"
  done
}

package() {
  local part
  for part in style sheet calc windows; do
    DESTDIR="$pkgdir" cmake --install "$srcdir/$part"
  done
}
