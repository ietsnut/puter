+/*
+ * puter: the title bar is a tab, only as wide as its buttons, its title and
+ * the theme's padding, at the window's top left; the rest of the strip above
+ * the window is not drawn, and since nothing is there, the cursor reaches
+ * whatever is beneath. A title that has to be cut short fills the whole
+ * width, as it did before. The title keeps puter's inset from the buttons.
+ */
+#define TAB_GAP 8
+static int
+get_tab_width(struct ssd *ssd, enum ssd_active_state active)
+{
+	int width = ssd->view->current.width;
+	struct ssd_state_title_width *dstate = &ssd->state.title.dstates[active];
+	if (dstate->truncated) {
+		return width;
+	}
+	int offset_left, offset_right;
+	get_title_offsets(ssd, &offset_left, &offset_right);
+	return MIN(width, offset_left + dstate->width + TAB_GAP + offset_right);
+}
+
+/*
+ * puter: the background, the right corner and the right-hand buttons end
+ * at the tab's right edge rather than the window's. The background starts
+ * where set_squared_corners() put it, after the left corner or at 0.
+ */
+static void
+update_tab(struct ssd *ssd)
+{
+	struct theme *theme = rc.theme;
+	int corner_width = ssd_get_corner_width();
+	int y = (theme->titlebar_height - theme->window_button_height) / 2;
+
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		struct ssd_titlebar_subtree *subtree = &ssd->titlebar.subtrees[active];
+		int width = get_tab_width(ssd, active);
+		int bg_offset = subtree->bar->node.x;
+
+		wlr_scene_buffer_set_dest_size(subtree->bar,
+			MAX(width - bg_offset * 2, 0), theme->titlebar_height);
+		wlr_scene_node_set_position(&subtree->corner_right->node,
+			width - corner_width, -theme->border_width);
+
+		int x = width - theme->window_titlebar_padding_width
+			+ theme->window_button_spacing;
+		struct ssd_button *button;
+		wl_list_for_each(button, &subtree->buttons_right, link) {
+			x -= theme->window_button_width + theme->window_button_spacing;
+			wlr_scene_node_set_position(button->node, x, y);
+		}
+	}
+}
+
