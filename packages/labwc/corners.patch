+/* puter: the shown tab's width, or 0 without a title bar */
+int
+ssd_get_tab_width(struct ssd *ssd)
+{
+	if (!ssd || ssd->titlebar.height <= 0) {
+		return 0;
+	}
+	bool active = ssd->titlebar.subtrees[SSD_ACTIVE].tree->node.enabled;
+	return get_tab_width(ssd, active ? SSD_ACTIVE : SSD_INACTIVE);
 }
 
