+
+/*
+ * puter: rounds tree, the window's (or its copy's as it closes), at the
+ * title bar's radius: the bottom corners, and the top ones too without a
+ * title bar (with one, it rounds its own). Fullscreen, it's square.
+ */
+void
+view_round(struct view *view, struct wlr_scene_tree *tree)
+{
+	uint32_t corners = 0;
+	if (!view->fullscreen) {
+		corners = WLR_SCENE_CORNER_BOTTOM_LEFT | WLR_SCENE_CORNER_BOTTOM_RIGHT;
+		if (!view->ssd || !view_titlebar_visible(view)) {
+			corners |= WLR_SCENE_CORNER_TOP_LEFT | WLR_SCENE_CORNER_TOP_RIGHT;
+		}
+	}
+	wlr_scene_tree_set_corners(tree, view->current.width,
+		view->current.height, rc.corner_radius, corners);
+}
