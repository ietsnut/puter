+/*
+ * puter: the window is rounded at the title bar's radius, and square where
+ * its title bar is (maximized, snapped and fullscreen): the bottom corners;
+ * the top right unless the tab reaches it; the top left without a title bar.
+ */
+void
+view_update_corners(struct view *view)
+{
+	if (!view->scene_tree) {
+		return;
+	}
+	uint32_t corners = 0;
+	if (!view->fullscreen && view->maximized != VIEW_AXIS_BOTH
+			&& !view_is_tiled_and_notify_tiled(view)) {
+		int tab_width = ssd_get_tab_width(view->ssd);
+		corners = WLR_SCENE_CORNER_BOTTOM_LEFT | WLR_SCENE_CORNER_BOTTOM_RIGHT;
+		if (tab_width < view->current.width) {
+			corners |= WLR_SCENE_CORNER_TOP_RIGHT;
+		}
+		if (!tab_width) {
+			corners |= WLR_SCENE_CORNER_TOP_LEFT;
+		}
+	}
+	wlr_scene_tree_set_corners(view->scene_tree, view->current.width,
+		view->current.height, rc.corner_radius, corners);
+}
