# puter's labwc: Arch's package (gitlab.archlinux.org/archlinux/packaging/
# packages/labwc) with pixels.patch, which reads a font's size in pixels
# rather than points, so its text is 15px like all of puter's (in whole
# points it could only be 14.67 or 16); corners.patch, which rounds the
# window's bottom corners at the title bar's radius (all four without a
# title bar, none fullscreen) and keeps the title bar's round maximized
# and snapped; gap.patch, which keeps a maximized window the gap (rc.xml)
# from the screen's edges, as snapped ones are; and animate.patch, which
# fades and grows a window in as it opens, and a copy of it out as it
# closes. The last three need puter's wlroots (packages/wlroots0.20).
# Built by CI (packages/build), which keeps it to Arch's version.
#
# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Lex Black <autumn-wind@web.de>

pkgname=labwc
pkgver=0.20.2
pkgrel=1.6
pkgdesc='stacking wayland compositor with look and feel from openbox'
url="https://github.com/labwc/labwc"
arch=('x86_64' 'aarch64')
license=('GPL-2.0-only')
depends=(
  cairo
  glib2
  glibc
  libinput
  libpng
  librsvg
  libsfdo
  wlroots0.20
  libxcb
  libxkbcommon
  libxml2
  pango
  pixman
  seatd
  ttf-font
  wayland
)
makedepends=(
  git
  meson
  scdoc
  wayland-protocols
  xorg-xwayland
)
optdepends=(
  "bemenu: default launcher via Alt+F3"
  "xorg-xwayland: X11 application support"
)
source=("git+https://github.com/labwc/labwc#tag=${pkgver}"
        pixels.patch
        corners.patch
        gap.patch
        animate.patch)
b2sums=('8f8023a5bc31e7fe52d80f1c99b02c59bd9ff9a3779145b9077dac3c2c4a78e291b99dc770039f90ac1ff548ff53adfeddad35de07f5d14d736b4c562ce3554f'
        '424411849e09b5dbae818b1b934414385b20af6b2ba60a1b0e4917a4ae109087a19a0d7af8ca531ce73e16e512fafeb467267baa984fff87283c8de836a48d18'
        '3b03ceb24b9979e2434dac8ae8cb21e80fea4ad0b181e02664c3bb7528e145e88e3c42ffd7a3536d83813903d14201acec91cb9dcbdd1b80fe0e8f4fc8e26ecf'
        'dd2b13f84417b739915287f8fad3dccea0152b46785496d81031391380b6514869a463cbf615e2e2a368f558487471945bbf75d8a667c2a55b22bdc40a0e2144'
        '9fa7adde539ea357aed73b8b23c26cfa29992f0246551faf650331dcd90ec21508708e7f44579c5e587eb1894eb87484465099c52f5dd93e650e616a801c089c')

prepare() {
  cd $pkgname
  # Fails if labwc ever moves the lines the patch touches.
  patch -p1 < ../pixels.patch
  patch -p1 < ../corners.patch
  patch -p1 < ../gap.patch
  patch -p1 < ../animate.patch
}

build() {
  arch-meson -Dman-pages=enabled "$pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
