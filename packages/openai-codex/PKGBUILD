# Codex, OpenAI's coding agent, for Arch Linux ARM, which hasn't packaged
# it: OpenAI's own aarch64 build (one static binary) from its GitHub
# release. On x86_64 puter takes Arch's package, built from source, so
# packages/build builds this one only for aarch64, following OpenAI's
# newest release (the checksum is the release's own digest).
pkgname=openai-codex
pkgver=0.163.0
pkgrel=1
pkgdesc='OpenAIs lightweight coding agent that runs in your terminal'
arch=('aarch64')
url='https://github.com/openai/codex'
license=('Apache-2.0')
depends=('bubblewrap' 'ripgrep')
options=('!strip' '!debug')
source=("codex-$pkgver.tar.gz::$url/releases/download/rust-v$pkgver/codex-aarch64-unknown-linux-musl.tar.gz")
sha256sums=('a7261e65f4a96d8f4ca65a069c6cf2dc2c33defc341e48078acefda9461fffe4')

package() {
  install -Dm755 codex-aarch64-unknown-linux-musl "$pkgdir/usr/bin/codex"
}
