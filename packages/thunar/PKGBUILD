# puter's Thunar: Arch's package (gitlab.archlinux.org/archlinux/packaging/
# packages/thunar) with one change, the path field's 5px margins taken out so
# the toolbar sits on puter's 30px grid. Built by install.sh; when Arch moves
# to a new Thunar, copy its PKGBUILD here again and keep the prepare() change.
#
# Maintainer: Evangelos Foutras <foutrelis@archlinux.org>
# Maintainer: T.J. Townsend <blakkheim@archlinux.org>
# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Andrew Simmons <andrew.simmons@gmail.com>

pkgname=thunar
pkgver=4.20.10
pkgrel=1.2
pkgdesc="Modern, fast and easy-to-use file manager for Xfce"
arch=('x86_64')
url="https://docs.xfce.org/xfce/thunar/start"
license=('GPL-2.0-or-later' 'LGPL-2.1-only')
groups=('xfce4')
depends=('desktop-file-utils' 'libexif' 'hicolor-icon-theme' 'libnotify'
         'pcre2' 'libgudev' 'exo' 'libxfce4util' 'libxfce4ui')
makedepends=('git' 'glib2-devel' 'gobject-introspection' 'xfce4-panel' 'xfce4-dev-tools')
optdepends=('catfish: file searching'
            'gvfs: trash support, mounting with udisk and remote filesystems'
            'tumbler: thumbnail previews'
            'thunar-volman: removable device management'
            'thunar-archive-plugin: archive creation and extraction'
            'thunar-media-tags-plugin: view/edit ID3/OGG tags')
source=("git+https://gitlab.xfce.org/xfce/thunar.git#tag=$pkgname-$pkgver")
sha256sums=('535214e04df1a56b94233e7b6f231f30f39eafe7a67bb235b0c3b4931edd10b6')

prepare() {
  cd $pkgname
  # No margins around the path field, so it starts on the grid right after
  # the last toolbar button. Fails if Thunar ever moves the line.
  grep -q '^#define DEFAULT_LOCATION_BAR_MARGIN 5$' thunar/thunar-window.c
  sed -i 's/^#define DEFAULT_LOCATION_BAR_MARGIN 5$/#define DEFAULT_LOCATION_BAR_MARGIN 0/' thunar/thunar-window.c
  # No icon in the path field, so its text starts one inset in like every
  # other field. Fails if Thunar ever renames the function.
  grep -q '^thunar_path_entry_update_icon (ThunarPathEntry \*path_entry)$' thunar/thunar-path-entry.c
  sed -i '/^thunar_path_entry_update_icon (ThunarPathEntry \*path_entry)$/{n;s/^{$/{\n  gtk_entry_set_icon_from_icon_name (GTK_ENTRY (path_entry), GTK_ENTRY_ICON_PRIMARY, NULL);\n  return;/}' thunar/thunar-path-entry.c
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-gio-unix \
    --enable-gudev \
    --enable-notifications \
    --enable-exif \
    --enable-gtk-doc \
    --disable-debug \
    --enable-maintainer-mode
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}

