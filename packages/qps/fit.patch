@@ -214,7 +214,8 @@
 
     // setTableFlags(Tbl_autoScrollBars | Tbl_smoothScrolling);
     setTableFlags(Tbl_snapToVGrid); // works
-    setTableFlags(Tbl_hScrollBar | Tbl_vScrollBar);
+    // puter: no sideways scroll bar; the table always fits (fitToWidth).
+    setTableFlags(Tbl_vScrollBar);
     first_drag_row = prev_drag_row = -1;
     autoscrolling = false;
     gadget_click = false;
@@ -479,7 +480,12 @@
         }
     }
 
-    p->drawText(gap, 0, w, h, align, htable->text(row, col));
+    // puter: a left-aligned text too long for its column ends in an
+    // ellipsis rather than running under the next.
+    QString text = htable->text(row, col);
+    if (htable->alignment_col[col] == Qt::AlignLeft)
+        text = fontMetrics().elidedText(text, Qt::ElideRight, qMax(0, w - gap - 5));
+    p->drawText(gap, 0, w, h, align, text);
 
     // cache write!
     attr->text = htable->text(row, col);
@@ -1025,20 +1031,30 @@
     if (hw > w)
         w = hw;
 
-    // to have an elegant table, spread the last column if its contents are left aligned
-    if (col == ncols - 1 && alignment_col[col] == Qt::AlignLeft)
-    {
-        int prevWidths = 0;
-        for (int i = 0 ; i < col; i++)
-            prevWidths += max_widths[i];
-        QScrollBar *vs = body->verticalScrollBar();
-        bool hidden = vs->minimum() == vs->maximum() // instead of !isVisible(), if update is paused
-                      || vs->style()->styleHint(QStyle::SH_ScrollBar_Transient, nullptr, vs);
-        int scrollWidth = hidden ? 0 : vs->style()->pixelMetric(QStyle::PM_ScrollBarExtent);
-        w = qMax(w, width() - scrollWidth - prevWidths);
-    }
+    // puter: every column a whole number of modules (30px), and the first
+    // left-aligned one (the name) taking what the others leave, so the table
+    // is exactly as wide as the window and never scrolls sideways.
+    max_widths[col] = (w + 29) / 30 * 30;
+    fitToWidth();
+}
 
-    max_widths[col] = w;
+void HeadedTable::fitToWidth()
+{
+    int stretch = -1;
+    for (int i = 0; i < ncols && stretch < 0; i++)
+        if (alignment(i) == Qt::AlignLeft)
+            stretch = i;
+    if (stretch < 0)
+        return;
+    int others = 0;
+    for (int i = 0; i < ncols; i++)
+        if (i != stretch)
+            others += max_widths[i];
+    QScrollBar *vs = body->verticalScrollBar();
+    bool hidden = vs->minimum() == vs->maximum() // instead of !isVisible(), if update is paused
+                  || vs->style()->styleHint(QStyle::SH_ScrollBar_Transient, nullptr, vs);
+    int scrollWidth = hidden ? 0 : vs->style()->pixelMetric(QStyle::PM_ScrollBarExtent);
+    max_widths[stretch] = qMax(30, width() - scrollWidth - others);
 }
 
 void HeadedTable::updateTable()
