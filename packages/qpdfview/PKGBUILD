# qpdfview (from the AUR's recipe): PDFs, in Qt Widgets on poppler. Built
# without PostScript and DjVu, and checked by its hash rather than its
# author's signature (no key to fetch on a fresh install).
pkgname=qpdfview
pkgver=0.5.0
pkgrel=3
pkgdesc="A tabbed PDF viewer using the poppler library"
url="https://launchpad.net/${pkgname}"
arch=(x86_64 aarch64)
license=(GPL-2.0-or-later)
depends=(libcups libsynctex poppler-qt6 qt6-svg)
makedepends=(qt6-tools)
source=(${url}/trunk/${pkgver}/+download/${pkgname}-${pkgver::-2}.tar.gz)
sha512sums=('1b6b479bb42f4568c21b5f6cb0c552c4323739ba9fe46cea80cc199f48b0b49a278e0a2fb0d21f83bafb467e43dd37352b99ef41795d140220bb82d704e03926')

prepare() {
  sed -i 's/CONFIG += c++11/CONFIG += c++17/' ${pkgname}-${pkgver::-2}/qpdfview.pri
}

build() {
  cd ${pkgname}-${pkgver::-2}
  /usr/lib/qt6/bin/lrelease qpdfview.pro
  qmake6 "CONFIG+=without_ps without_djvu" qpdfview.pro
  make
}

package() {
  cd ${pkgname}-${pkgver::-2}
  make INSTALL_ROOT="$pkgdir" install
}
