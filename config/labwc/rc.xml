<?xml version="1.0"?>
<!-- labwc stacks windows, so everything floats. Colours are in the puter theme (theme/labwc). -->
<labwc_config>

  <!-- New windows step down and right from the top left, one module at a time. -->
  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="30" y="30" />
  </placement>

  <theme>
    <name>puter</name>
    <titlebar>
      <!-- The app's square (its icon, theme/make) first; it opens the window
           menu, as the menu button did. -->
      <layout>icon:iconify,max,close</layout>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <dropShadows>no</dropShadows>
    <font place="ActiveWindow"><name>puter-sans</name><size>11</size></font>
    <font place="InactiveWindow"><name>puter-sans</name><size>11</size></font>
    <font place="MenuItem"><name>puter-sans</name><size>11</size></font>
    <font place="OnScreenDisplay"><name>puter-sans</name><size>11</size></font>
  </theme>

  <!-- Windows-style snapping: drag a title bar to the left or right edge for
       half the screen, to the top to maximise; corners give quarters. The
       halves are 32 x 35 modules, so a snapped window stays on the grid. -->
  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>60</cornerRange>
    <overlay enabled="yes">
      <delay inner="300" outer="300" />
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <desktops number="1" />

  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="qterminal" /></keybind>
    <keybind key="W-space"><action name="Execute" command="qs ipc call search toggle" /></keybind>
    <!-- The Windows key (Command on a Mac keyboard) on its own opens search too:
         on release, and only when no other key was pressed with it, so
         Super+Left and the rest still work. -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="qs ipc call search toggle" /></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute" command="qs ipc call search toggle" /></keybind>
    <keybind key="W-Escape"><action name="ShowMenu" menu="root-menu" /></keybind>
    <!-- Alt+Tab: the shell's switcher (config/quickshell/Switcher.qml), in
         place of labwc's. -->
    <keybind key="A-Tab"><action name="Execute" command="qs ipc call switcher next" /></keybind>
    <keybind key="A-S-Tab"><action name="Execute" command="qs ipc call switcher previous" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-f"><action name="ToggleMaximize" /></keybind>
    <!-- Super+arrows snap to a half; a second press the other way makes a quarter. -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes" /></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" combine="yes" /></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" combine="yes" /></keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <!-- Apps that open at the size they last had (seldom on the grid) are
       sized when their first window maps: 24 x 18 modules, mail 48 x 26; only main windows, not their dialogs. The others are set in
       their own settings (install.sh). -->
  <windowRules>
    <windowRule type="normal" identifier="qpdfview*"><action name="ResizeTo" width="720" height="540" /></windowRule>
    <windowRule type="normal" identifier="lxqt-archiver"><action name="ResizeTo" width="720" height="540" /></windowRule>
    <windowRule type="normal" identifier="org.mozilla.Thunderbird"><action name="ResizeTo" width="1440" height="780" /></windowRule>
    <windowRule type="normal" identifier="qps"><action name="ResizeTo" width="720" height="540" /></windowRule>
  </windowRules>
</labwc_config>
