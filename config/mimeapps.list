# Which app opens what: text in FeatherPad, tables in Sheet, photos in
# LXImage-Qt, videos in mpv, folders in PCManFM-Qt, the web in Firefox.
[Default Applications]
inode/directory=pcmanfm-qt.desktop
text/plain=featherpad.desktop
text/markdown=featherpad.desktop
text/x-python=featherpad.desktop
text/x-csrc=featherpad.desktop
text/x-chdr=featherpad.desktop
text/x-c++src=featherpad.desktop
text/x-shellscript=featherpad.desktop
text/x-qml=featherpad.desktop
application/json=featherpad.desktop
application/xml=featherpad.desktop
application/x-shellscript=featherpad.desktop
image/png=lximage-qt.desktop
image/jpeg=lximage-qt.desktop
image/gif=lximage-qt.desktop
image/webp=lximage-qt.desktop
image/svg+xml=lximage-qt.desktop
image/heif=lximage-qt.desktop
video/mp4=mpv.desktop
video/webm=mpv.desktop
video/x-matroska=mpv.desktop
video/quicktime=mpv.desktop
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
text/csv=puter-sheet.desktop
text/tab-separated-values=puter-sheet.desktop
text/html=firefox.desktop
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
