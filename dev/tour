#!/usr/bin/env python3
"""Open every app and dialog on the VM and check each against the grid.

    dev/tour                    every step
    dev/tour featherpad-open    only the steps named (or starting with a name)

Each step starts its app fresh, presses its keys (shortcuts, or a menu's
letter after Alt) and screenshots what opens to dev/shots/tour/STEP.png; dev/grid
checks it, marking what's off in dev/shots/tour/STEP-grid.png. Ends with a summary.
"""
import pathlib
import shutil
import subprocess
import sys
import time

root = pathlib.Path(__file__).resolve().parent.parent
out = root / "dev" / "shots" / "tour"

# (step, app, its process name, keys). A key is a combination like "ctrl+o"
# or "alt+e", a named key like "Return", "click X Y" in screenshot pixels, or
# a letter or word typed.
STEPS = [
    ("featherpad", "featherpad", "featherpad", []),
    ("featherpad-open", "featherpad", "featherpad", ["ctrl+o"]),
    ("featherpad-save", "featherpad", "featherpad", ["ctrl+shift+s", "End"]),
    ("featherpad-preferences", "featherpad", "featherpad", ["alt+o", "p"]),
    ("featherpad-font", "featherpad", "featherpad", ["alt+o", "f"]),
    ("featherpad-unsaved", "featherpad", "featherpad", ["x", "ctrl+q"]),
    ("featherpad-about", "featherpad", "featherpad", ["alt+h", "a"]),
    ("pcmanfm", "pcmanfm-qt", "pcmanfm-qt", []),
    ("pcmanfm-preferences", "pcmanfm-qt", "pcmanfm-qt", ["alt+e", "Up", "Return"]),
    ("pcmanfm-properties", "pcmanfm-qt", "pcmanfm-qt", ["alt+f", "f"]),
    ("qterminal", "qterminal", "qterminal", []),
    # QTerminal hands Alt to the shell, so its Session menu is clicked.
    ("qterminal-preferences", "qterminal", "qterminal", ["click 637 283", "Up", "Up", "Return"]),
    ("lximage", "lximage-qt", "lximage-qt", []),
    ("lximage-preferences", "lximage-qt", "lximage-qt", ["alt+e", "Up", "Return"]),
    ("firefox", "firefox", "firefox", []),
    # A second tab brings the tab bar; Alt+F opens the File menu.
    ("firefox-tabs", "firefox", "firefox", ["ctrl+t"]),
    ("firefox-menu", "firefox", "firefox", ["alt+f"]),
    ("sheet", "puter-sheet", "puter-sheet", []),
]
APPS = sorted({process for _, _, process, _ in STEPS})
# Steps whose keys change the app's window rather than open one: checked
# whole, not by what changed.
IN_PLACE = {"firefox-tabs", "firefox-menu"}
NAMED = {"Return", "Escape", "Tab", "Down", "Up", "Left", "Right", "End", "Home", "BackSpace"}
MODIFIERS = {"ctrl", "shift", "alt", "logo"}


def vm(command):
    env = "export XDG_RUNTIME_DIR=/run/user/$(id -u) WAYLAND_DISPLAY=wayland-0 DISPLAY=:0;"
    return subprocess.run(["ssh", "archvm", env + command], capture_output=True, text=True)


def press(key):
    if key.startswith("click "):
        subprocess.run([root / "dev" / "click", *key.split()[1:]], check=True)
        return
    parts = key.split("+")
    if len(parts) > 1 and all(p in MODIFIERS for p in parts[:-1]):
        mods = parts[:-1]
        args = [f"-M {m}" for m in mods] + [parts[-1]] + [f"-m {m}" for m in reversed(mods)]
        vm("wtype " + " ".join(args))
    elif key in NAMED:
        vm(f"wtype -k {key}")
    else:
        vm(f"wtype '{key}'")


def close():
    """Close every app, and the file dialogs, which the portal owns."""
    vm("; ".join(f"pkill -x {a}" for a in APPS)
       + "; systemctl --user restart xdg-desktop-portal-lxqt; true")


def main():
    names = sys.argv[1:]
    steps = [s for s in STEPS if not names or any(s[0] == n or s[0].startswith(n + "-") for n in names)]
    out.mkdir(parents=True, exist_ok=True)
    summary = []
    for step, app, process, keys in steps:
        close()
        time.sleep(1)
        subprocess.run([root / "dev" / "run", app], check=True)
        time.sleep(8 if app == "firefox" else 4)
        # A dialog is checked on its own: what changed on screen once its keys
        # were pressed (it may open right over its app, sharing its outline).
        before = out / f"{step}-before.png"
        compare = keys and step not in IN_PLACE
        if compare:
            subprocess.run([root / "dev" / "shot", before], check=True, stdout=subprocess.DEVNULL)
        for key in keys:
            press(key)
            time.sleep(1)
        time.sleep(2)
        shot = out / f"{step}.png"
        subprocess.run([root / "dev" / "shot", shot], check=True, stdout=subprocess.DEVNULL)
        check = subprocess.run([root / "dev" / "grid", shot, *(["--before", before] if compare else [])],
                               capture_output=True, text=True)
        shutil.copy(root / "dev" / "shots" / "grid.png", out / f"{step}-grid.png")
        report = [l for l in check.stdout.splitlines() if not l.endswith("grid.png")]
        off = sum(1 for l in report if l.startswith("  ") and l.strip() != "on the grid")
        if check.returncode and not off:
            off = 1  # nothing measured: no window found
        print(f"== {step}: {'on the grid' if check.returncode == 0 else f'{off} off'}")
        print("\n".join(report))
        summary.append((step, off))
    close()
    print("\nSummary:")
    for step, off in summary:
        print(f"  {step:26} {'ok' if off == 0 else f'{off} off'}")
    return 1 if any(off for _, off in summary) else 0


if __name__ == "__main__":
    sys.exit(main())
