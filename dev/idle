#!/bin/bash
# How much puter costs at rest, on the VM: the processor's use and memory
# with nothing open, then with every app open, each after a minute of
# leaving the desktop alone.
#
#   dev/idle          both
#   dev/idle bare     only with nothing open
#
# CPU is each process's own time (user + system, from /proc/PID/stat) over
# the minute, so 0.0% means it didn't run at all; memory is PSS (its share
# of the pages it uses, shared ones split between their users).
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
apps="featherpad pcmanfm-qt qterminal lximage-qt firefox puter-sheet"

measure() {
  ssh archvm "python3 - '$1'" <<'PY'
import os, sys, time

def processes():
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/stat") as f:
                fields = f.read().rsplit(")", 1)[1].split()
            with open(f"/proc/{pid}/comm") as f:
                name = f.read().strip()
            if os.stat(f"/proc/{pid}").st_uid != os.getuid():
                continue
            out[int(pid)] = (name, int(fields[11]) + int(fields[12]))
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            pass
    return out

def pss(pid):
    try:
        with open(f"/proc/{pid}/smaps_rollup") as f:
            for line in f:
                if line.startswith("Pss:"):
                    return int(line.split()[1])
    except (FileNotFoundError, PermissionError):
        pass
    return 0

def system_busy():
    with open("/proc/stat") as f:
        v = list(map(int, f.readline().split()[1:]))
    return sum(v) - v[3] - v[4], sum(v)

seconds, tick = 60, os.sysconf("SC_CLK_TCK")
time.sleep(10)  # let what was just started settle
a, (busy0, total0) = processes(), system_busy()
time.sleep(seconds)
b, (busy1, total1) = processes(), system_busy()

rows = []
for pid, (name, t1) in b.items():
    t0 = a.get(pid, (name, t1))[1]
    rows.append((name, pid, 100 * (t1 - t0) / tick / seconds, pss(pid) / 1024))
rows.sort(key=lambda r: -r[3])
print(f"{sys.argv[1]}: system busy {100 * (busy1 - busy0) / (total1 - total0):.2f}% over {seconds} s")
print(f"  {'process':24} {'cpu':>6} {'pss MB':>8}")
for name, pid, cpu, mem in rows:
    if mem >= 1 or cpu > 0:
        print(f"  {name:24} {cpu:5.1f}% {mem:8.1f}")
print(f"  {'(user total)':24} {sum(r[2] for r in rows):5.1f}% {sum(r[3] for r in rows):8.1f}")
with open("/proc/meminfo") as f:
    m = {l.split(":")[0]: int(l.split()[1]) for l in f}
print(f"  system memory in use: {(m['MemTotal'] - m['MemAvailable']) / 1024:.0f} MB of {m['MemTotal'] / 1024:.0f} MB")
PY
}

close_all() {
  ssh archvm "for a in $apps; do pkill -x \$a; done; true"
  sleep 2
}

close_all
measure "nothing open"
if [[ ${1:-} != bare ]]; then
  for app in $apps; do "$root/dev/run" "$app"; sleep 3; done
  measure "every app open"
  close_all
fi
