#!/bin/bash
# Use the VM's desktop live from the Mac: tunnels the VM's screen (VNC, only
# reachable on the devbox) to localhost:5901 and opens it in Screen Sharing,
# with the VNC password read from the devbox. The tunnel keeps running in the
# background; `dev/screen stop` closes it.
set -euo pipefail
port=5901

if [[ ${1:-} == stop ]]; then
  pkill -f "ssh .*-L $port:127.0.0.1:5900 server" && echo "tunnel closed"
  exit 0
fi

if ! nc -z localhost "$port" 2>/dev/null; then
  ssh -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L "$port:127.0.0.1:5900" server
fi
password="$(ssh server cat archvm/vnc-password)"
open "vnc://:$password@localhost:$port"
