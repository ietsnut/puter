#!/bin/bash
# Mac → VM: copy this checkout to ~/puter on the VM, relink and apply its
# settings, and reload the desktop. Quickshell reloads itself when its files
# change; labwc needs a nudge. Both keep the icons they've looked up for as
# long as they run, so when the icon theme changes (a new app's square, say)
# the shell is started afresh, and labwc is told to reconfigure.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
changed="$(rsync -az --delete --exclude .git --itemize-changes "$root/" archvm:puter/)"
ssh archvm 'puter/install.sh config >/dev/null && (pkill -HUP -x labwc || true)'
if grep -q ' theme/icons/' <<<"$changed"; then
  ssh archvm 'pkill -x quickshell || true; sleep 1'
  "$root/dev/run" quickshell
  echo "icons changed: the shell was restarted"
fi
