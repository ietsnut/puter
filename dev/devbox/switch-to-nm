#!/bin/bash
# Moves the VM from systemd-networkd to NetworkManager; reverts after 60s if
# that leaves it without an address.
systemctl disable --now systemd-networkd.service systemd-networkd.socket
systemctl enable --now NetworkManager.service
sleep 60
if ! ip -4 addr show eth0 | grep -q "inet "; then
  systemctl disable --now NetworkManager.service
  systemctl enable --now systemd-networkd.service
fi
