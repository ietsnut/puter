#!/bin/bash
# puter on a Mac with Apple silicon, in a window: puter's virtual machine
# (ghcr.io/ietsnut/puter-vm, the aarch64 build of puter installed on a
# disk, from .github/workflows/vm.yml) in QEMU with Apple's hypervisor, so
# at the Mac's own speed. Needs QEMU: brew install qemu.
#
# This checkout is shared with the machine (at /mnt/puter, read-only) and
# copied over its ~/puter once it's up, so it runs what you edit. File
# events don't cross the share, so `watch` copies each file as you save it:
# a write in there, which Quickshell sees and reloads itself on (QML, at
# once), and labwc is told to reload its config; `apply` does the rest.
#
#   vm/try             start it; the first time (or with `update`) it's
#                      downloaded, about 3 GB
#   vm/try update      download the newest, and start over on it
#   vm/try fresh       start over on the one downloaded, forgetting changes
#   vm/try watch       copies each file into the machine as it changes here;
#                      Quickshell reloads QML by itself, labwc's config is
#                      reloaded, and it says when `apply` is needed
#   vm/try reload      labwc's config again, and Quickshell started again
#   vm/try apply       install.sh config, then reload: after changing what
#                      install.sh sets up (theme/ after theme/make, the
#                      apps' settings, new files); about 20 seconds
#   vm/try do CMD      run CMD on it as puter, in the desktop's session, and
#                      print what it prints
#   vm/try shot [FILE] a screenshot of it (FILE is /tmp/puter.png unless
#                      given), and its path
#
# What you change on the machine is kept between runs, beside the download
# in ~/Library/Caches/puter (a disk of its own over the downloaded one,
# which itself is never changed). The window is 40 x 25 modules (1200 x
# 750); PUTER_SIZE=WxH for another, PUTER_MEMORY (6G) and PUTER_CPUS (4).
# Ctrl+Alt+G lets go of the keyboard and pointer.
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cache="$HOME/Library/Caches/puter"
serial="$cache/serial.sock"
monitor="$cache/monitor.sock"
mkdir -p "$cache"

# Talks to the running machine: its serial console (a shell as puter,
# logging in if need be) or QEMU's monitor.
console() { # serial|monitor TEXT
  python3 - "$@" <<'PY'
import re, socket, sys, time
kind, text = sys.argv[1], sys.argv[2]
# One connection at a time: wait a little for another to finish.
for attempt in range(30):
    c = socket.socket(socket.AF_UNIX)
    try:
        c.connect(f"{__import__('os').environ['HOME']}/Library/Caches/puter/{kind}.sock")
        break
    except FileNotFoundError:
        sys.exit("puter isn't running: start it with vm/try")
    except OSError:
        c.close()
        time.sleep(0.5)
else:
    sys.exit("puter's console is busy")
c.settimeout(0.2)

# What came back, without the terminal's escape sequences (the shell puts
# systemd's around its prompt).
escapes = re.compile(rb"\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b\[[0-9;?]*[a-zA-Z]|\r")
def read(until, seconds):
    out, end = b"", time.time() + seconds
    while time.time() < end:
        try:
            out += c.recv(65536)
        except socket.timeout:
            pass
        if until and re.search(until, escapes.sub(b"", out)):
            break
    return escapes.sub(b"", out)

if kind == "monitor":
    c.sendall(text.encode() + b"\n")
    read(None, 1.5)
    sys.exit()

# A shell: log in as puter (no password) if the console isn't at one.
prompt = rb"(login: *|Password: *|\$ *)$"
out = b""
for attempt in range(6):
    c.sendall(b"\n")
    out = read(prompt, 5)
    if re.search(rb"login: *$", out):
        c.sendall(b"puter\n")
        out = read(prompt, 10)
    if re.search(rb"Password: *$", out):
        c.sendall(b"\n")
        out = read(prompt, 10)
    if re.search(rb"\$ *$", out):
        break
else:
    sys.exit("couldn't log in on puter's console")
c.sendall(b"stty -echo cols 200; export PAGER=cat SYSTEMD_PAGER=cat TERM=dumb\n")
read(rb"\$ *$", 3)
mark = f"puter{time.time_ns()}"
c.sendall(f"echo {mark}A; {text}; echo {mark}Z$?\n".encode())
out = read(rf"{mark}Z\d+".encode(), 3600).decode(errors="replace")
body = out.split(f"{mark}A", 1)[-1]
status = re.search(rf"{mark}Z(\d+)", body)
sys.stdout.write(body.split(f"{mark}Z")[0].lstrip("\n"))
sys.exit(int(status.group(1)) if status else 1)
PY
}

# A command in the desktop's session: its environment, its bus, its display.
session() {
  console serial "(set -a; . ~/.config/labwc/environment; export XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$(id -u)/bus; set +a; $*)"
}

# This checkout, shared at /mnt/puter, and its files (not its .git) copied
# over the machine's own ~/puter, as puter's.
mount_share() {
  mountpoint=$(console serial "mountpoint -q /mnt/puter && echo yes || true")
  [[ $mountpoint == yes* ]] && return 0
  console serial "sudo mkdir -p /mnt/puter && sudo mount -t 9p -o ro,trans=virtio,version=9p2000.L,msize=524288 puter /mnt/puter" || return 1
  copy_all
}
copy_all() {
  console serial "tar -C /mnt/puter --exclude=./.git -cf - . | tar -C ~/puter --no-same-owner -xf -"
}

case "${1:-}" in
  do)
    shift
    session "$*"
    exit
    ;;
  watch)
    echo "Watching $repo (Ctrl+C to stop)"
    python3 - "$repo" "$0" <<'PY'
import os, subprocess, sys, time
repo, me = sys.argv[1], sys.argv[2]
def state():
    seen = {}
    for top in ("config", "theme", "bin", "install.sh"):
        path = os.path.join(repo, top)
        if os.path.isfile(path):
            seen[top] = os.stat(path).st_mtime_ns
            continue
        for root, dirs, files in os.walk(path):
            for name in files:
                full = os.path.join(root, name)
                try:
                    seen[os.path.relpath(full, repo)] = os.stat(full).st_mtime_ns
                except FileNotFoundError:
                    pass
    return seen
before = state()
while True:
    time.sleep(0.4)
    now = state()
    changed = sorted(f for f in set(now) | set(before) if now.get(f) != before.get(f))
    before = now
    if not changed:
        continue
    print(time.strftime("%H:%M:%S"), ", ".join(changed), flush=True)
    # Each one copied in (or deleted) on the machine: a write there.
    q = lambda f: "'" + f.replace("'", "'\\''") + "'"
    script = "; ".join(
        f"mkdir -p ~/puter/$(dirname {q(f)}) && cp -f /mnt/puter/{q(f)} ~/puter/{q(f)}" if f in now
        else f"rm -f ~/puter/{q(f)}" for f in changed)
    if any(f.startswith("config/labwc/") for f in changed):
        script += "; pkill -HUP -x labwc"
    subprocess.run([me, "do", script])
    if any(not f.startswith(("config/quickshell/", "config/labwc/")) for f in changed):
        print("  (vm/try apply to take the rest in)", flush=True)
PY
    exit
    ;;
  reload)
    mount_share
    session "pkill -HUP -x labwc; pkill -x quickshell; sleep 0.5; setsid -f quickshell >/dev/null 2>&1; echo reloaded"
    exit
    ;;
  apply)
    mount_share
    copy_all
    session "cd ~/puter && ./install.sh config >/dev/null && pkill -HUP -x labwc && echo applied"
    exit
    ;;
  shot)
    file="${2:-/tmp/puter.png}"
    [[ $file == /* ]] || file="$PWD/$file"
    console monitor "screendump $file -f png"
    echo "$file"
    exit
    ;;
esac

if [[ $(uname -sm) != "Darwin arm64" ]]; then
  echo "vm/try is for a Mac with Apple silicon." >&2
  exit 1
fi
if ! command -v qemu-system-aarch64 >/dev/null; then
  echo "QEMU is needed: brew install qemu" >&2
  exit 1
fi
firmware="$(brew --prefix qemu 2>/dev/null || echo /opt/homebrew)/share/qemu"

case "${1:-}" in
  update)
    "$repo/iso/download" "$cache/puter.qcow2" puter-vm
    rm -f "$cache/disk.qcow2" "$cache/vars.fd"
    ;;
  fresh) rm -f "$cache/disk.qcow2" "$cache/vars.fd" ;;
  "") [[ -f $cache/puter.qcow2 ]] || "$repo/iso/download" "$cache/puter.qcow2" puter-vm ;;
  *) echo "usage: vm/try [update|fresh|watch|reload|apply|do CMD|shot [FILE]]" >&2; exit 1 ;;
esac

# Your disk, over the downloaded one, and the machine's firmware settings.
[[ -f $cache/disk.qcow2 ]] ||
  qemu-img create -q -f qcow2 -b "$cache/puter.qcow2" -F qcow2 "$cache/disk.qcow2"
[[ -f $cache/vars.fd ]] || cp "$firmware/edk2-arm-vars.fd" "$cache/vars.fd"

# Once it's up, this checkout goes over its ~/puter.
(
  for _ in $(seq 60); do
    sleep 2
    mount_share >/dev/null 2>&1 && exit
  done
) &

size="${PUTER_SIZE:-1200x750}"
rm -f "$serial" "$monitor"
qemu-system-aarch64 -name puter -machine virt -accel hvf -cpu host \
  -smp "${PUTER_CPUS:-4}" -m "${PUTER_MEMORY:-6G}" \
  -drive if=pflash,format=raw,readonly=on,file="$firmware/edk2-aarch64-code.fd" \
  -drive if=pflash,format=raw,file="$cache/vars.fd" \
  -drive file="$cache/disk.qcow2",if=virtio,discard=unmap \
  -device virtio-gpu-pci,xres="${size%x*}",yres="${size#*x}" -display cocoa \
  -device qemu-xhci -device usb-kbd -device usb-tablet \
  -nic user,model=virtio-net-pci -device virtio-rng-pci \
  -virtfs local,path="$repo",mount_tag=puter,security_model=mapped-xattr \
  -serial unix:"$serial",server,nowait -monitor unix:"$monitor",server,nowait
