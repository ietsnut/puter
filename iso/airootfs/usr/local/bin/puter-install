#!/bin/bash
# puter's installer, run on the USB stick's live system as soon as it has
# started (iso/build adds it to root's .zlogin on tty1). It asks only which
# disk to erase, then installs puter on it without a network: every package
# is on the stick (/opt/puter/offline, a pacman repository iso/build made),
# and so are puter itself (/opt/puter/puter, a git checkout) and Claude
# Code (/opt/puter/claude). The machine then
# restarts straight into the desktop, with no password anywhere
# (install.sh's access and login).
#
# puter.disk=/dev/X on the kernel command line installs there without
# asking and powers off afterwards (how CI tests the stick, in QEMU).
#
# It also makes puter's virtual machine (vm/build), in a container rather
# than on a stick: PUTER_IMAGE=/dev/loopN installs onto that, from
# PUTER_SRC (iso/payload's), without asking, without touching this
# machine's firmware settings, and without restarting it.
set -euo pipefail
src="${PUTER_SRC:-/opt/puter}"
user=puter
image="${PUTER_IMAGE:-}"

disk="${image:-$(sed -n 's/.*puter\.disk=\([^ ]*\).*/\1/p' /proc/cmdline)}"
unattended=${disk:+1}
# Unattended, everything goes to the serial console too, for CI to read.
if [[ -n $unattended && -w /dev/ttyS0 ]]; then
  exec > >(tee /dev/ttyS0) 2>&1
fi

failed() {
  local status=$?
  ((status == 0)) && return
  echo "!! The install stopped (see above)."
  if [[ -n $unattended && -z $image ]]; then poweroff; fi
}
trap failed EXIT

if [[ -z $image && ! -d /sys/firmware/efi ]]; then
  echo "puter starts through UEFI, and this machine started the stick without it."
  echo "Turn on UEFI (or turn off legacy/CSM) in its firmware settings, and try again."
  exit 1
fi

if [[ -z $disk ]]; then
  # The disks, without the stick itself.
  stick="$(lsblk -no PKNAME "$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)" 2>/dev/null || true)"
  mapfile -t disks < <(lsblk -dpno NAME,TYPE,SIZE,MODEL | awk -v stick="/dev/$stick" \
    '$2 == "disk" && $1 != stick && $1 !~ /zram/ {name = $1; $1 = $2 = ""; print name " " $0}')
  if ((${#disks[@]} == 0)); then
    echo "There's no disk to install puter on."
    exit 1
  fi
  echo
  echo "puter installs on a disk of its own, erasing everything on it."
  echo
  PS3="Which disk? "
  select line in "${disks[@]}"; do
    [[ -n $line ]] && break
  done
  disk="${line%% *}"
  read -r -p "Erase everything on $disk and install puter? Type yes: " answer
  [[ $answer == yes ]] || exit 1
fi

echo "== The disk: $disk"
umount -R /mnt 2>/dev/null || true
[[ -n $image ]] || swapoff -a
wipefs -af "$disk"
sgdisk --zap-all "$disk"
sgdisk -n1:0:+1G -t1:ef00 -c1:boot -n2:0:0 -t2:8304 -c2:puter "$disk"
partprobe "$disk"
udevadm settle || true
# The partitions, whatever they're called (sda1, nvme0n1p1, vda1).
mapfile -t parts < <(lsblk -pnlo NAME,TYPE "$disk" | awk '$2 == "part" {print $1}')
mkfs.fat -F 32 -n BOOT "${parts[0]}"
mkfs.ext4 -F -L puter "${parts[1]}"
mount "${parts[1]}" /mnt
mount --mkdir -o umask=0077 "${parts[0]}" /mnt/boot

echo "== The packages, from the stick"
conf="$(mktemp)"
cat >"$conf" <<CONF
[options]
Architecture = auto
ParallelDownloads = 5
$(grep -x DisableSandbox /etc/pacman.conf || true)

# Not checked again: pacstrap checks against the stick's own keyring,
# which hasn't puter's key, and the stick is what's trusted anyway (iso/build
# checked every package as it downloaded them).
[offline]
SigLevel = Never
Server = file://$src/offline
CONF
# (bash: the checkout's scripts aren't executable until it's on the disk.)
mapfile -t pkgs < <(bash "$src/puter/bin/puter-update" packages)
# The stick's packages stand in for the new system's package cache, so
# they aren't copied onto the disk as well.
mkdir -p /mnt/var/cache/pacman/pkg
# (Writable, or pacman copies them all to /tmp, in memory: it only writes
# there for a package that isn't there, and every one is.)
mount --bind "$src/offline" /mnt/var/cache/pacman/pkg
pacstrap -C "$conf" -K /mnt "${pkgs[@]}"
umount /mnt/var/cache/pacman/pkg
# The new keyring trusts every keyring package installed (Arch Linux ARM's
# doesn't add itself, as Arch's does, and pacman then refuses its
# packages), and pacstrap -K leaves its gpg-agent running, from out here.
arch-chroot /mnt pacman-key --populate
gpgconf --homedir /mnt/etc/pacman.d/gnupg --kill gpg-agent || true
# The two partitions by UUID, written here rather than by genfstab, which
# needs udev to know them (a container has none) and lists this machine's
# swap as well.
cat >>/mnt/etc/fstab <<FSTAB
UUID=$(blkid -s UUID -o value "${parts[1]}")  /      ext4  rw,relatime  0 1
UUID=$(blkid -s UUID -o value "${parts[0]}")  /boot  vfat  rw,relatime,fmask=0077,dmask=0077  0 2
FSTAB
# Arch's own mirrors from now on (its worldwide CDN); Arch Linux ARM's
# mirror list already names its own.
if [[ $(uname -m) == x86_64 ]]; then
  # shellcheck disable=SC2016  # pacman's own variables
  echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' >/mnt/etc/pacman.d/mirrorlist
fi

echo "== The system"
root_uuid="$(blkid -s UUID -o value "${parts[1]}")"
# The kernel: Arch's (vmlinuz-linux) or Arch Linux ARM's (Image).
kernel=vmlinuz-linux
[[ -e /mnt/boot/Image ]] && kernel=Image
# An image's firmware settings are its own machine's, not this one's, and
# it has a serial console as well as its screen (the screen last, so it's
# where the system speaks).
variables=yes
console=""
if [[ -n $image ]]; then
  variables=no
  console="console=ttyAMA0 console=tty1 "
fi
arch-chroot /mnt bash -s <<CHROOT
set -euo pipefail
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc || true
sed -i 's/^#en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen
locale-gen
echo LANG=en_US.UTF-8 >/etc/locale.conf
echo puter >/etc/hostname
# No password at all: greetd starts the desktop as $user, and sudo and
# polkit never ask (install.sh's access). root can't log in.
useradd -m -G wheel -s /bin/bash $user
passwd -d $user
passwd -l root
bootctl install --variables=$variables
cat >/boot/loader/loader.conf <<LOADER
default puter.conf
timeout 0
editor no
LOADER
cat >/boot/loader/entries/puter.conf <<ENTRY
title puter
linux /$kernel
initrd /initramfs-linux.img
options ${console}root=UUID=$root_uuid rw quiet
ENTRY
CHROOT

echo "== puter"
cp -a "$src/puter" "/mnt/home/$user/puter"
arch-chroot /mnt chown -R "$user:" "/home/$user/puter"
# mkarchiso copies the stick's files without their modes, so the scripts
# have lost being executable; git puts back what it recorded.
arch-chroot /mnt runuser -u "$user" -- git -C "/home/$user/puter" reset -q --hard
# Claude Code, where Anthropic's installer puts it (executable again, for
# the same reason), before install.sh config gives it the desktop.
version="$(basename "$(ls "$src"/claude/*)")"
install -D -m 755 "$src/claude/$version" "/mnt/home/$user/.local/share/claude/versions/$version"
mkdir -p "/mnt/home/$user/.local/bin"
ln -sfn "/home/$user/.local/share/claude/versions/$version" "/mnt/home/$user/.local/bin/claude"
# What Anthropic's installer records about itself (without it `claude
# update` warns its install method is unknown); install.sh config adds to it.
echo '{"installMethod": "native", "autoUpdates": false}' >"/mnt/home/$user/.claude.json"
arch-chroot /mnt chown "$user:" "/home/$user/.claude.json"
arch-chroot /mnt chown -R "$user:" "/home/$user/.local"
arch-chroot /mnt "/home/$user/puter/bin/puter-update" repo
# install.sh's access, which sudo needs before it can run without a
# password (it's put in place again, the same, by access itself).
echo "$user ALL=(ALL:ALL) NOPASSWD: ALL" >/mnt/etc/sudoers.d/10-puter
chmod 440 /mnt/etc/sudoers.d/10-puter
arch-chroot /mnt runuser -u "$user" -- env HOME="/home/$user" USER="$user" LOGNAME="$user" \
  bash -c 'cd ~/puter && ./install.sh access && ./install.sh config && ./install.sh login'
# A virtual machine has no GPU: labwc draws with pixman (with OpenGL on
# llvmpipe, virtio's screen only updates where a frame changed, and
# wlroots crashes on OpenGL apps), and OpenGL apps draw in software.
if [[ -n $image ]]; then
  sed -i 's/^command = "labwc"$/command = "env WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1 labwc"/' /mnt/etc/greetd/config.toml
fi

# What the settings started inside the new system (gvfs and dconf, for
# gsettings' session bus) outlives them; it goes, so the disk unmounts.
for proc in /proc/[0-9]*; do
  [[ $(readlink "$proc/root" 2>/dev/null) == /mnt ]] && kill "${proc#/proc/}" 2>/dev/null
done
sleep 1
if ! umount -R /mnt; then
  echo "!! /mnt is still in use, by:"
  for proc in /proc/[0-9]*; do
    if [[ $(readlink "$proc/root" 2>/dev/null) == /mnt* || $(readlink "$proc/cwd" 2>/dev/null) == /mnt* ]]; then
      echo "   ${proc#/proc/} $(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null)"
    fi
  done
  grep ' /mnt' /proc/mounts
  exit 1
fi
echo "::installed"
if [[ -n $image ]]; then
  :
elif [[ -n $unattended ]]; then
  poweroff
else
  echo
  echo "puter is installed. Take the stick out; restarting in 10 seconds."
  sleep 10
  reboot
fi
