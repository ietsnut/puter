#!/bin/bash
# Builds puter's USB installer: Arch's own install medium (archiso's releng
# profile) with puter's installer (airootfs/usr/local/bin/puter-install,
# started on tty1), every package puter installs as a pacman repository on
# the stick (/opt/puter/offline), puter itself as a git checkout
# (/opt/puter/puter) and Claude Code (/opt/puter/claude), so it installs
# without a network. Runs as root in a
# privileged Arch container (.github/workflows/iso.yml):
#
#   iso/build WORK OUT    builds in WORK, writes OUT/puter.iso
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
work="$(readlink -f "${1:?usage: iso/build WORK OUT}")"
out="$(readlink -f "${2:?usage: iso/build WORK OUT}")"
mkdir -p "$work" "$out"

pacman -Syu --noconfirm --needed archiso git

profile="$work/profile"
rm -rf "$profile"
cp -r /usr/share/archiso/configs/releng "$profile"
cp -r "$repo/iso/airootfs/." "$profile/airootfs/"
# The live system in zstd rather than xz (read about nine times faster,
# every boot), and the packages left as they are, being zstd already.
# shellcheck disable=SC2016  # profiledef.sh expands these itself
sed -i -e 's/^iso_name=.*/iso_name="puter"/' \
  -e 's/^iso_label=.*/iso_label="PUTER_$(date --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y%m)"/' \
  -e 's|^iso_publisher=.*|iso_publisher="puter <https://github.com/ietsnut/puter>"|' \
  -e 's/^iso_application=.*/iso_application="puter installer"/' \
  -e '/^file_permissions=(/a \  ["/usr/local/bin/puter-install"]="0:0:755"' \
  -e "s|^airootfs_image_tool_options=.*|airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '19' '-b' '1M' '-action' 'uncompressed@subpathname(opt/puter/offline)')|" \
  "$profile/profiledef.sh"
# The installer starts once the live system has logged in on tty1.
# shellcheck disable=SC2016  # for zsh, on the stick
echo '[[ $(tty) == /dev/tty1 ]] && puter-install' >>"$profile/airootfs/root/.zlogin"

# What the installer installs from: every package, Claude Code and puter
# itself (iso/payload).
"$repo/iso/payload" "$profile/airootfs/opt/puter" "$work/payload"

mkarchiso -v -w "$work/archiso" -o "$work/iso" "$profile"
mv "$work"/iso/puter-*.iso "$out/puter.iso"
ls -lh "$out/puter.iso"
