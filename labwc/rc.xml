<?xml version="1.0"?>
<!-- labwc stacks windows, so everything floats. Colours are in the puter theme (theme/labwc). -->
<labwc_config>

  <!-- New windows step down and right from the top left, one module at a time. -->
  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="30" y="30" />
  </placement>

  <theme>
    <name>puter</name>
    <titlebar>
      <layout>menu:iconify,max,close</layout>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <dropShadows>no</dropShadows>
    <font place="ActiveWindow"><name>Geist</name><size>11</size></font>
    <font place="InactiveWindow"><name>Geist</name><size>11</size></font>
    <font place="MenuItem"><name>Geist</name><size>11</size></font>
    <font place="OnScreenDisplay"><name>Geist</name><size>11</size></font>
  </theme>

  <!-- Windows-style snapping: drag a title bar to the left or right edge for
       half the screen, to the top to maximise; corners give quarters. The
       halves are 32 x 35 modules, so a snapped window stays on the grid. -->
  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>60</cornerRange>
    <overlay enabled="yes">
      <delay inner="300" outer="300" />
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <desktops number="1" />

  <!-- imv asks to draw its own frame and draws none; it gets puter's. -->
  <windowRules>
    <windowRule identifier="imv" serverDecoration="yes" />
  </windowRules>

  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="ghostty" /></keybind>
    <keybind key="W-space"><action name="Execute" command="qs ipc call search toggle" /></keybind>
    <keybind key="W-Escape"><action name="ShowMenu" menu="root-menu" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-f"><action name="ToggleMaximize" /></keybind>
    <!-- Super+arrows snap to a half; a second press the other way makes a quarter. -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes" /></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" combine="yes" /></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" combine="yes" /></keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

</labwc_config>
