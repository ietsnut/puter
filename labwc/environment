# The session's environment, read by labwc at login and so by everything
# started from the desktop.

# Qt Widgets apps take puter's style, palette, fonts and stylesheet from qt6ct.
QT_QPA_PLATFORMTHEME=qt6ct
# Quickshell (the bar, search, settings) draws with Qt's software renderer: the
# shell is flat rectangles and text, and this uses a third of the memory of
# drawing it through OpenGL.
QT_QUICK_BACKEND=software
# GTK 3 apps and Electron ask the portal for their file dialogs too, so every
# app gets the same one (xdg-desktop-portal/).
GTK_USE_PORTAL=1
