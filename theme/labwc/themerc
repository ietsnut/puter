# Written by theme/make from theme/palette; edit those, not this.
# A one-module title bar in the title colour, focused or not, paper bodies,
# square and flat, with a 1px outline. The buttons are the SVGs beside this
# file.
border.width: 1
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0
window.label.text.justify: left

window.active.title.bg.color: #958d79
window.inactive.title.bg.color: #958d79
window.active.label.text.color: #060606
window.inactive.label.text.color: #060606
window.active.border.color: #060606
window.inactive.border.color: #060606

window.button.width: 30
window.button.height: 30
window.button.spacing: 0
window.button.hover.bg.color: #ffffff
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 0
window.inactive.shadow.size: 0

menu.border.width: 1
menu.border.color: #060606
menu.items.bg.color: #ffffff
menu.items.text.color: #060606
menu.items.active.bg.color: #e0a9df
menu.items.active.text.color: #060606
menu.items.padding.x: 8
menu.items.padding.y: 6
menu.width.min: 180
menu.separator.width: 1
menu.separator.padding.width: 0
menu.separator.padding.height: 0
menu.separator.color: #d6d1cb

osd.bg.color: #ffffff
osd.border.width: 1
osd.border.color: #060606
osd.label.text.color: #060606
osd.window-switcher.style-classic.item.active.border.width: 0
osd.window-switcher.style-classic.item.active.bg.color: #e0a9df

# Where a dragged window will snap: a plain 2px outline in ink, no fill.
snapping.overlay.region.bg.enabled: no
snapping.overlay.edge.bg.enabled: no
snapping.overlay.region.border.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: #060606
snapping.overlay.edge.border.color: #060606
