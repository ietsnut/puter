# Windows in three colours: a black one-module title bar, its text and buttons
# white when focused and gray when not, white bodies, square and flat. The
# colours are quickshell/Theme.qml's; the buttons are the SVGs beside this
# file, written by ../make-buttons.
border.width: 0
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0
window.label.text.justify: left

window.active.title.bg.color: #000000
window.inactive.title.bg.color: #000000
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #808080
window.active.border.color: #000000
window.inactive.border.color: #000000

window.button.width: 30
window.button.height: 30
window.button.spacing: 0
window.button.hover.bg.color: #808080
window.button.hover.bg.corner-radius: 0

window.active.shadow.size: 0
window.inactive.shadow.size: 0

menu.border.width: 0
menu.items.bg.color: #000000
menu.items.text.color: #ffffff
menu.items.active.bg.color: #808080
menu.items.active.text.color: #000000
menu.items.padding.x: 8
menu.items.padding.y: 6
menu.width.min: 180
menu.separator.width: 2
menu.separator.padding.width: 0
menu.separator.padding.height: 0
menu.separator.color: #ffffff

osd.bg.color: #000000
osd.border.width: 0
osd.label.text.color: #ffffff
osd.window-switcher.style-classic.item.active.border.width: 0
osd.window-switcher.style-classic.item.active.bg.color: #808080

# Where a dragged window will snap: a plain 2px black outline, no fill.
snapping.overlay.region.bg.enabled: no
snapping.overlay.edge.bg.enabled: no
snapping.overlay.region.border.enabled: yes
snapping.overlay.edge.border.enabled: yes
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: #000000
snapping.overlay.edge.border.color: #000000
