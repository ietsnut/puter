# PICO-8 (Lexaloffle, lospec.com/palette-list/pico-8): sixteen colours.
# Roles on the left, the palette's colours on the right. `theme/make` writes
# every app's colours from the palette named in theme/palette.

# The interface.
desk          lavender
paper         white
ink           dark-blue
accent        yellow
accent-ink    dark-blue
muted         light-grey
muted-ink     dark-grey

# Window buttons under the pointer: the square filled, the glyph turned over.
button-hover      dark-blue
button-hover-ink  white
close-hover       red
close-hover-ink   white

# Syntax highlighting in the text editor, on paper.
code-comment   dark-grey
code-keyword   dark-purple
code-string    dark-green
code-number    brown
code-type      dark-blue
code-constant  red

# The terminal's sixteen ANSI colours, on paper.
ansi0   black
ansi1   red
ansi2   dark-green
ansi3   brown
ansi4   dark-blue
ansi5   dark-purple
ansi6   blue
ansi7   light-grey
ansi8   dark-grey
ansi9   red
ansi10  dark-green
ansi11  orange
ansi12  blue
ansi13  pink
ansi14  lavender
ansi15  white

