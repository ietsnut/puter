# Stack: after Koto's identity for Stack Overflow (2026) and Butterfly's
# Pond. A charcoal desk dotted on the grid, paper windows under black title
# bars, and a few strong colours that mark rather than fill: every app has
# its own, shown as a square on its title bar and taskbar tab. Set in Stack
# Sans, Koto's typeface for it (theme/fonts, SIL OFL).
# Roles on the left, the palette's colours on the right. `theme/make` writes
# every app's colours from the palette named in theme/palette.

# The interface.
desk          charcoal
desk-dot      charcoal-light  # a dot at every module corner on the desk
bar           ink             # the taskbar strip and the clock
bar-ink       paper
bar-edge      ink             # a line along the bar's top: the bar's colour, so none
tab           ink             # a window's tab on the taskbar
tab-ink       sand
tab-active    paper           # the focused window's tab
tab-active-ink  ink
paper         paper
ink           ink
accent        lilac           # highlights and selections
accent-ink    ink
muted         bone            # headers, the bar's other tabs
muted-ink     stone-dark
outline       ink             # the thin edge around windows, menus and popups
rule          sand            # the lighter lines inside: table grids, dividers
title         ink             # title bars, and a window's tab when focused
title-ink     paper

# What's under the pointer inside apps: buttons, tabs, the scroll bar.
hover         sand
hover-ink     ink

# Window buttons under the pointer: the square filled, the glyph turned over.
button-hover      charcoal-light
button-hover-ink  paper
close-hover       orange
close-hover-ink   ink

# Syntax highlighting in the text editor, on paper.
code-comment   stone-dark
code-keyword   periwinkle-dark
code-string    lime-dark
code-number    orange
code-type      ink
code-constant  lilac-dark
code-function  periwinkle-dark
code-builtin   plum
code-regex     red
code-tag       purple
code-value     cyan
code-other     yellow-dark

