# Stack, dark: the same brown desk, beetle and colours, with the windows, bar
# and tabs in warm near-blacks and the type light. The brights (cyan, lime,
# pink) keep black type on them. puter's default (theme/palette); `stack`
# is the light one.
# Roles on the left, the palette's colours on the right. `theme/make` writes
# every app's colours from the palette named in theme/palette.

# The interface.
desk          cherry          # deep cherry-wood brown
desk-dot      cherry          # no grid
# The beetle in the desk's middle, and the names under its icons (Desk.qml).
mark          bone
# The desk's folders (Desk.qml): flat pixel folders.
folder        cyan
bar           mint            # the floating bar's pills and the clock
bar-ink       ink
bar-edge      mint            # no line along the bar
search        cyan            # the search mark's tile
search-ink    black
tab           mint            # a window's tab on the bar
tab-ink       ink
tab-active    charcoal-light  # the focused window's tab
tab-active-ink  ink
paper         paper
ink           ink
accent        cyan            # highlights and selections
accent-ink    black
muted         mint            # headers, the bar's other tabs
muted-ink     stone
outline       mint            # no outlines: where an edge must be drawn, it's the faintest fill
frame         gray  # a 1px line around every window, the bar's pills and panels, for contrast
rule          mint-dark       # the lines inside: table grids, dividers
title         mint            # title bars, and the open tab inside apps
title-ink     ink
title-active  paper           # the focused window's tab: it joins its body

# What's under the pointer inside apps: buttons, tabs, the scroll bar.
hover         mint-dark
hover-ink     ink

# The bar's buttons and tabs, and the window buttons, under the pointer.
button-hover      lime
button-hover-ink  black
close-hover       pink
close-hover-ink   black
# An agent's taskbar tab while it waits for you (bin/puter-agent).
attention         pink
attention-ink     black

