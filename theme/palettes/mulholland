# Mulholland: black, white and grays, with a little blue, coral and pink. The
# grays and accents are IBM Carbon's, as on Mulholland's website; the black
# outlines are the dental desk's and its printed reports'.
# Roles on the left, the palette's colours on the right. `theme/make` writes
# every app's colours from the palette named in theme/palette.

# The interface.
desk          gray-20
desk-dot      gray-20  # a dot at every module corner on the desk (here unseen)
bar           white    # the taskbar strip and the clock
bar-ink       gray-100
bar-edge      black    # a 1px line along the bar's top
search        white    # the search square in the bar's corner
search-ink    gray-100
tab           gray-10  # a window's tab on the taskbar
tab-ink       gray-60
tab-active    gray-20  # the focused window's tab
tab-active-ink  gray-100
paper         white
ink           gray-100
accent        gray-20  # highlights and selections (no colour yet)
accent-ink    gray-100
muted         gray-10
muted-ink     gray-60
outline       black    # the thin edge around windows, menus and popups
rule          gray-30  # the lighter lines inside: table grids, dividers
title         gray-20  # a focused title bar, and its window's tab
title-ink     gray-100

# What's under the pointer inside apps: buttons, tabs, the scroll bar.
hover         gray-30
hover-ink     gray-100

# Window buttons under the pointer: the square filled, the glyph turned over.
button-hover      gray-30
button-hover-ink  gray-100
close-hover       gray-30
close-hover-ink   gray-100
# An agent's taskbar tab while it waits for you (bin/puter-agent).
attention         gray-30
attention-ink     gray-100

# Syntax highlighting in the text editor, on paper.
code-comment   gray-60
code-keyword   blue-dark
code-string    green
code-number    coral-dark
code-type      gray-100
code-constant  magenta
code-function  blue
code-builtin   magenta
code-regex     red
code-tag       purple
code-value     cyan
code-other     yellow-dark

# The terminal's sixteen ANSI colours, on paper.
ansi0   gray-100
ansi1   red
ansi2   green
ansi3   yellow-dark
ansi4   blue
ansi5   magenta
ansi6   cyan
ansi7   gray-30
ansi8   gray-60
ansi9   coral
ansi10  green-light
ansi11  yellow
ansi12  blue-light
ansi13  pink
ansi14  cyan-light
ansi15  white

