"""Writes every colour and icon in puter from the palette named in theme/palette
(a file in theme/palettes/: roles, then the palette's colours, fonts and the
colour of each app).

  config/quickshell/Colors.qml   the interface roles, for the shell
  config/fontconfig/conf.d/      puter-sans and puter-mono, the fonts every
                                 app is set in, as the palette's fonts
  theme/labwc/themerc            title bars, menus, the window switcher
  theme/labwc/*.svg              the window buttons
  theme/icons/                   the icon theme (theme/icons.map, from
                                 Carbon), and each app's square in its colour
  theme/gtk-3.0/colors.css       the roles, for GTK 3 apps
  theme/qt6ct/puter.qss          the Qt stylesheet, from theme/qt/puter.qss
  theme/qt6ct/puter.conf         the Qt palette
  theme/featherpad/              the text editor's syntax colours
  theme/kicad/puter.json         KiCad's board, schematic and 3D colours
  theme/qterminal/puter.colorscheme  the terminal
  theme/foot/foot.ini            the agents' terminal
  theme/qpdfview/colors          the PDF viewer's page colours
  theme/firefox/chrome/          Firefox's stylesheet, from theme/firefox
  theme/thunderbird/chrome/      Thunderbird's, from theme/thunderbird

Icons and glyphs are IBM's Carbon icons (theme/carbon), named in
theme/icons.map. Run it after changing a palette, theme/palette or the icon
map, then dev/sync.
"""
import re
from pathlib import Path

theme = Path(__file__).parent
repo = theme.parent


def read_palette():
    """From theme/palettes/<name>: role lines, then [colors], [fonts] (a
    family name, spaces and all) and [apps] (an app's icon name and its
    colour). Returns role -> hex, font -> family, icon -> hex."""
    name = (theme / "palette").read_text().strip()
    sections, section = {None: {}, "colors": {}, "fonts": {}, "apps": {}}, None
    for line in (theme / "palettes" / name).read_text().splitlines():
        if line.lstrip().startswith("#"):
            continue
        # Hex colours start with "#", so only text after a space and "#" is a comment.
        line = line.split(" #", 1)[0].strip() if section != "colors" else line.strip()
        if not line:
            continue
        if line.startswith("["):
            section = line.strip("[]")
            continue
        key, value = line.split(None, 1)
        sections[section][key] = value if section == "fonts" else value.split()[0]
    colors = sections["colors"]
    resolve = lambda table: {key: colors.get(value, value) for key, value in table.items()}
    return resolve(sections[None]), sections["fonts"], resolve(sections["apps"])


C, FONTS, APPS = read_palette()


