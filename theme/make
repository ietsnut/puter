    # The window menu: three bars. It also gives the title its inset, since
    # labwc has no padding for the title text alone.
    "menu": rects((10, 10, 10, 2), (10, 14, 10, 2), (10, 18, 10, 2)),
    "iconify": rects((10, 18, 10, 2)),
    "max": rects((10, 10, 10, 2), (10, 18, 10, 2), (10, 12, 2, 6), (18, 12, 2, 6)),
    # Restore: a smaller square, with the top and right edges of one behind it.
    "max_toggled": rects(
        (10, 12, 8, 2), (10, 18, 8, 2), (10, 14, 2, 4), (16, 14, 2, 4),
        (12, 10, 8, 2), (18, 12, 2, 6),
    ),
    # The cross: two strokes corner to corner, clipped square on the box.
    "close": (
        '<clipPath id="box"><rect x="10" y="10" width="10" height="10"/></clipPath>'
        '<g clip-path="url(#box)" stroke-width="2" fill="none" stroke="{ink}">'
        '<line x1="9" y1="9" x2="21" y2="21"/><line x1="21" y1="9" x2="9" y2="21"/></g>'
    ),
}
def button(body, ink, fill=None):
    square = f'<rect width="30" height="30" fill="{fill}"/>' if fill else ""
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 30 30">'
            f'{square}<g fill="{ink}">{body.format(ink=ink)}</g></svg>\n')


# Each button as it sits on a focused or unfocused title bar, and under the
# pointer: the whole square filled and the glyph turned over, red for close.
# (labwc draws these hover images in place of its own hover colour.)
for name, body in BUTTONS.items():
    hover, hover_ink = (C["close-hover"], C["close-hover-ink"]) if name == "close" else (C["button-hover"], C["button-hover-ink"])
    for state, ink in (("active", C["accent-ink"]), ("inactive", C["muted-ink"])):
        (theme / "labwc" / f"{name}-{state}.svg").write_text(button(body, ink))
        (theme / "labwc" / f"{name}_hover-{state}.svg").write_text(button(body, hover_ink, hover))


