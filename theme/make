# labwc: the window buttons. A button is one module (30 x 30); its glyph sits
# in the 10 x 10 box from 10 to 20.
def rects(*boxes):
    return "".join(f'<rect x="{x}" y="{y}" width="{w}" height="{h}"/>' for x, y, w, h in boxes)


