        "[scrollback]", "lines=10000", "",
        "[cursor]", "style=block", "blink=no", "",
        "[mouse]", "hide-when-typing=yes", "",
        "[csd]", "preferred=server", "",
        "[colors-light]", f"background={hex6('paper')}", f"foreground={hex6('ink')}",
        f"selection-background={hex6('accent')}", f"selection-foreground={hex6('accent-ink')}",
        f"urls={hex6('ansi4')}"]
foot += [f"regular{i}={hex6(f'ansi{i}')}" for i in range(8)]
foot += [f"bright{i}={hex6(f'ansi{i + 8}')}" for i in range(8)]
(theme / "foot").mkdir(exist_ok=True)
(theme / "foot" / "foot.ini").write_text("\n".join(foot) + "\n")


