def icon(size, box, path, scale=1):
    offset = (size - box * scale) // 2
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 {size} {size}">'
            f'<clipPath id="box"><rect x="{offset}" y="{offset}" width="{box * scale}" height="{box * scale}"/></clipPath>'
            f'<g clip-path="url(#box)"><path transform="translate({offset} {offset}) scale({scale})" d="{path}" '
            f'fill="none" stroke="{C["ink"]}" stroke-width="2" vector-effect="non-scaling-stroke"/></g></svg>\n')


