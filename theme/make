#!/usr/bin/env python3
"""Writes every colour and icon in puter from the palette named in theme/palette
(a file in theme/palettes/: roles, then the palette's colours).

  quickshell/Colors.qml      the interface roles, for the shell
  theme/labwc/themerc        title bars, menus, the window switcher
  theme/labwc/*.svg          the window buttons
  theme/icons/               places and file icons
  theme/gtk-3.0/colors.css   the roles, for GTK 3 apps
  qt6ct/qss/puter.qss        the Qt stylesheet, from theme/qt/puter.qss
  qt6ct/colors/puter.conf    the Qt palette
  featherpad/                the text editor's syntax colours
  theme/kicad/puter.json     KiCad's board, schematic and 3D colours
  qterminal/puter.colorscheme  the terminal

Every glyph is drawn in 2px vector strokes in a 10 x 10 box. Straight strokes
sit on whole pixels so they are sharp; diagonals and curves are smooth. Run it after
changing a palette or theme/palette, then dev/sync.
"""
from pathlib import Path

theme = Path(__file__).parent
repo = theme.parent


def read_palette():
    """Role -> hex, from theme/palettes/<name>: role lines, then [colors]."""
    name = (theme / "palette").read_text().strip()
    roles, colors, section = {}, {}, None
    for line in (theme / "palettes" / name).read_text().splitlines():
        if line.lstrip().startswith("#"):
            continue
        # Hex colours start with "#", so only text after a space and "#" is a comment.
        line = line.split(" #", 1)[0].strip() if section != "colors" else line.strip()
        if not line:
            continue
        if line.startswith("["):
            section = line.strip("[]")
            continue
        key, value = line.split()[:2]
        (colors if section == "colors" else roles)[key] = value
    return {role: colors.get(value, value) for role, value in roles.items()}


C = read_palette()


