# Icons and glyphs are IBM's Carbon icons (theme/carbon, Apache 2.0): every
# one in ink, at 16px from Carbon's own 16px drawing where it has one, and
# from its 32px one halved otherwise (Carbon draws on even pixels, so halved
# its 2px lines are sharp 1px ones); at 64px the 32px drawing doubled.
# Carbon's SVGs are plain paths and circles, so Qt's SVG renderer (SVG Tiny,
# which draws a clip path as a filled square) draws them as they are.
import xml.etree.ElementTree as ET

CARBON = theme / "carbon"
ET.register_namespace("", "http://www.w3.org/2000/svg")


def carbon(name, small):
    """A Carbon icon's shapes, as markup, and the size of the grid they're on:
    its 16px drawing when small and it has one, its 32px one otherwise."""
    path = CARBON / "16" / f"{name}.svg"
    if not (small and path.exists()):
        path = CARBON / "32" / f"{name}.svg"
    root = ET.parse(path).getroot()
    grid = int(float(root.get("viewBox").split()[2]))
    body = "".join(ET.tostring(e, encoding="unicode").replace(' xmlns="http://www.w3.org/2000/svg"', "")
                   for e in root)
    return body, grid


# Hinting. Carbon centres its icons on the middle of the grid, so a line down
# the middle of a 16px glyph runs from 7.5 to 8.5: two gray pixels rather
# than one in ink. Each 16px glyph is drawn four ways, nudged half a pixel
# across, down, both or neither, and the sharpest kept: the one with the
# least in between ink and nothing (rsvg-convert draws them; PIL reads them).
import io
import subprocess
from PIL import Image

HINTS = {}


def hint(name):
    """The half-pixel nudge (dx, dy) that draws a 16px glyph sharpest."""
    if name not in HINTS:
        body, grid = carbon(name, small=True)
        best = None
        for dx in (0, 0.5):
            for dy in (0, 0.5):
                svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">'
                       f'<g transform="translate({dx} {dy}) scale({16 / grid:g})">{body}</g></svg>')
                png = subprocess.run(["rsvg-convert", "-w", "16", "-h", "16"], input=svg.encode(),
                                     capture_output=True, check=True).stdout
                alpha = Image.open(io.BytesIO(png)).getchannel("A")
                gray = sum(n * min(v, 255 - v) for v, n in enumerate(alpha.histogram()))
                if best is None or gray < best[0]:
                    best = (gray, (dx, dy))
        HINTS[name] = best[1]
    return HINTS[name]


def glyph(name, canvas, box, ink, fill=None):
    """A Carbon icon drawn box pixels square in the middle of a canvas pixels
    square (on whole pixels, nudged by its hint at 16px), in ink, on a filled
    square if fill is given."""
    body, grid = carbon(name, small=box <= 16)
    dx, dy = hint(name) if box == 16 else (0, 0)
    offset, scale = (canvas - box) // 2, box / grid
    square = f'<rect width="{canvas}" height="{canvas}" fill="{fill}"/>' if fill else ""
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{canvas}" height="{canvas}" '
            f'viewBox="0 0 {canvas} {canvas}">{square}'
            f'<g transform="translate({offset + dx:g} {offset + dy:g}) scale({scale:g})" fill="{ink}">{body}</g></svg>\n')


# labwc: the window buttons, one module each (30 x 30), their 16px glyph in
# the middle. Each as it sits on a title bar and under the pointer: the whole
# square filled and the glyph turned over, the close colour for close. (labwc
# draws these hover images in place of its own hover colour.) The menu
# button isn't in the title bar (the app's square is), but is made anyway.
BUTTONS = {"close": "close", "iconify": "subtract", "max": "maximize",
           "max_toggled": "minimize", "menu": "menu"}
for name, icon in BUTTONS.items():
    hover, hover_ink = (C["close-hover"], C["close-hover-ink"]) if name == "close" else (C["button-hover"], C["button-hover-ink"])
    for state in ("active", "inactive"):
        (theme / "labwc" / f"{name}-{state}.svg").write_text(glyph(icon, 30, 16, C["title-ink"]))
        (theme / "labwc" / f"{name}_hover-{state}.svg").write_text(glyph(icon, 30, 16, hover_ink, hover))


# The icon theme: every name in theme/icons.map at 16 (its glyph sharp at
# 16px), 24 (the same 16px glyph, centred, rather than a blurred 24px one)
# and 64 (the 32px drawing doubled, for icon views); the window buttons'
# glyphs as symbolic icons, in black for GTK to recolour; and each app's
# square in its colour.
DRAWN = {}  # (size, context, name): svg
for line in (theme / "icons.map").read_text().splitlines():
    fields = line.split("#", 1)[0].split()
    if len(fields) != 3:
        continue
    name, context, icon = fields
    DRAWN[16, context, name] = glyph(icon, 16, 16, C["ink"])
    DRAWN[24, context, name] = glyph(icon, 24, 16, C["ink"])
    DRAWN[64, context, name] = glyph(icon, 64, 64, C["ink"])
for name, icon in (("window-close", "close"), ("window-minimize", "subtract"),
                   ("window-maximize", "maximize"), ("window-restore", "minimize"),
                   ("open-menu", "menu")):
    DRAWN[16, "actions", name] = glyph(icon, 16, 16, C["ink"])
    DRAWN[16, "actions", f"{name}-symbolic"] = glyph(icon, 16, 16, "#000000")
    DRAWN[24, "actions", name] = glyph(icon, 24, 16, C["ink"])


# Apps: a solid square in the app's colour, 10px at 16 and 14px at 24, so a
# title bar, a taskbar tab and search show which app is which by colour.
def square(size, side, color):
    o = (size - side) // 2
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" viewBox="0 0 {size} {size}">'
            f'<rect x="{o}" y="{o}" width="{side}" height="{side}" fill="{color}"/></svg>\n')


for name, color in APPS.items():
    DRAWN[16, "apps", name] = square(16, 10, color)
    DRAWN[24, "apps", name] = square(24, 14, color)
    DRAWN[64, "apps", name] = square(64, 40, color)


icons = theme / "icons"
for old in icons.glob("[0-9]*x[0-9]*"):
    for f in sorted(old.rglob("*"), reverse=True):
        f.unlink() if f.is_file() else f.rmdir()
    old.rmdir()
for (size, context, name), svg in DRAWN.items():
    folder = icons / f"{size}x{size}" / context
    folder.mkdir(parents=True, exist_ok=True)
    (folder / f"{name}.svg").write_text(svg)
dirs = sorted({f"{size}x{size}/{context}" for size, context, _ in DRAWN})
index = ["[Icon Theme]", "Name=puter", "Comment=IBM Carbon icons in the palette's ink",
         "Inherits=breeze,hicolor", "Directories=" + ",".join(dirs), ""]
for d in dirs:
    size = int(d.split("x")[0])
    index += [f"[{d}]", f"Size={size}", f"Context={d.split('/')[1].capitalize()}"]
    index += ["Type=Scalable", "MinSize=25", "MaxSize=256"] if size == 64 else ["Type=Fixed"]
    index.append("")
(icons / "index.theme").write_text("\n".join(index))


