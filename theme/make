for (size, context, name), svg in DRAWN.items():
    folder = icons / f"{size}x{size}" / context
    folder.mkdir(parents=True, exist_ok=True)
    for n in [name] + [a for a, t in ALIASES.items() if t == name]:
        (folder / f"{n}.svg").write_text(svg)
dirs = sorted({f"{size}x{size}/{context}" for size, context, _ in DRAWN})
index = ["[Icon Theme]", "Name=puter", "Comment=2px line icons", "Inherits=breeze,hicolor",
         "Directories=" + ",".join(dirs), ""]
for d in dirs:
    size = int(d.split("x")[0])
    index += [f"[{d}]", f"Size={size}", f"Context={d.split('/')[1].capitalize()}"]
    index += ["Type=Scalable", "MinSize=25", "MaxSize=256"] if size == 64 else ["Type=Fixed"]
    index.append("")
(icons / "index.theme").write_text("\n".join(index))


