# The text editor: a GtkSourceView scheme from the roles. Code and Markdown
# both draw from these few styles.
def style(name, fg=None, bg=None, bold=False, italic=False, underline=False):
    attrs = f'name="{name}"'
    attrs += f' foreground="{fg}"' if fg else ""
    attrs += f' background="{bg}"' if bg else ""
    attrs += ' bold="true"' if bold else ""
    attrs += ' italic="true"' if italic else ""
    attrs += ' underline="single"' if underline else ""
    return f"  <style {attrs}/>\n"


