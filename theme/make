    "/* Written by theme/make from theme/qt/puter.qss and theme/palette;\n"
    "   edit those, not this. */\n" + qss
)
def qt_palette(text, muted_text):
    return ", ".join(C[r] if r in C else r for r in (
        text, "paper", "paper", "muted", "rule", "rule", text, "paper", text,
        "paper", "paper", "outline", "accent", "accent-ink", "ink", "ink",
        "paper", "paper", "paper", "ink", muted_text, "accent"))
# FeatherPad's syntax colours: its own file, eleven keys that must each be a
# different colour (a repeat makes it throw the file away).
(repo / "featherpad").mkdir(exist_ok=True)
(repo / "featherpad" / "fp_light_syntax_colors.conf").write_text(
    "[General]\n" + "".join(f"{key}={C[role]}\n" for key, role in (
        ("function", "code-function"), ("BuiltinFunction", "code-builtin"),
        ("comment", "code-comment"), ("quote", "code-string"), ("type", "code-type"),
        ("keyWord", "code-keyword"), ("number", "code-number"), ("regex", "code-regex"),
        ("xmlElement", "code-tag"), ("cssValue", "code-value"), ("other", "code-other"),
    ))
)
(repo / "qt6ct" / "colors").mkdir(parents=True, exist_ok=True)
(repo / "qt6ct" / "colors" / "puter.conf").write_text(
    "# Written by theme/make from theme/palette; edit those, not this.\n[ColorScheme]\n"
    f"active_colors={qt_palette('ink', 'muted-ink')}\n"
    f"inactive_colors={qt_palette('ink', 'muted-ink')}\n"
    f"disabled_colors={qt_palette('muted-ink', 'muted-ink')}\n"
)


# The terminal (QTerminal): paper and ink and the palette's sixteen ANSI
# roles, as a QTermWidget colour scheme.
def rgb3(role):
    h = C[role]
    return ",".join(str(int(h[i:i + 2], 16)) for i in (1, 3, 5))
scheme = ["# Written by theme/make from theme/palette; edit those, not this.",
          "[General]", "Description=puter", "Opacity=1", "",
          "[Background]", f"Color={rgb3('paper')}", "",
          "[BackgroundIntense]", f"Color={rgb3('paper')}", "",
          "[Foreground]", f"Color={rgb3('ink')}", "",
          "[ForegroundIntense]", f"Color={rgb3('ink')}", "Bold=false", ""]
for i in range(8):
    scheme += [f"[Color{i}]", f"Color={rgb3(f'ansi{i}')}", "",
               f"[Color{i}Intense]", f"Color={rgb3(f'ansi{i + 8}')}", ""]
(repo / "qterminal").mkdir(exist_ok=True)
(repo / "qterminal" / "puter.colorscheme").write_text("\n".join(scheme))



# KiCad: boards, schematics and the 3D view from the palette's KiCad roles.
# Masks and highlights are see-through, as KiCad's own themes draw them.
def rgb(role, alpha=1.0):
    hexa = C[role]
    r, g, b = (int(hexa[i:i + 2], 16) for i in (1, 3, 5))
    return f"rgba({r}, {g}, {b}, {alpha})" if alpha < 1 else f"rgb({r}, {g}, {b})"


