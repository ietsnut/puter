/* Qt Widgets apps (FeatherPad, PCManFM-Qt, LXImage-Qt, QTerminal,
   puter's table editor) in puter's look, one stylesheet for all of them,
   applied by qt6ct. @role names a colour role from the palette; theme/make
   fills them in and writes qt6ct/qss/puter.qss. Edit this, not that.

   The grid: every bar, row, button and field is one 30px module, text one
   8px inset in. The puter widget style (src/style) takes away the frames and
   margins Qt keeps around bars and menus, which a stylesheet can't reach;
   the heights here pin each styled widget to its module (Qt adds pixels of
   its own to styled widgets, so padding alone doesn't land them). Square corners, no shadows, a 1px outline around
   popups and fields, light rules inside, gray under the pointer. */

* {
    outline: none;
}

QToolTip {
    background: @paper;
    color: @ink;
    border: 1px solid @outline;
    padding: 0 7px;
    min-height: 28px;
    max-height: 28px;
}

/* The menu bar: paper, each menu's name one inset in, a light rule along its
   foot inside its module. */
QMenuBar {
    background: @paper;
    color: @ink;
    border: none;
    border-bottom: 1px solid @rule;
    padding: 0;
    spacing: 0;
}
QMenuBar::item {
    background: transparent;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background: @accent;
    color: @accent-ink;
}

/* Menus: paper with the outline, an item per module, a light rule between
   sections. */
QMenu {
    background: @paper;
    color: @ink;
    border: 1px solid @outline;
    padding: 0;
    margin: 0;
}
QMenu::item {
    background: transparent;
}
QMenu::item:selected {
    background: @accent;
    color: @accent-ink;
}
QMenu::item:disabled {
    color: @muted-ink;
}
QMenu::separator {
    height: 1px;
    background: @rule;
    margin: 0;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 8px;
}
QMenu::right-arrow {
    width: 16px;
    height: 16px;
    margin-right: 7px;
}

/* Minimal: no app shows a toolbar or a status bar (apps show them
   regardless of settings, so they are made no height at all). Everything a
   toolbar offers is in the app's menus, and what a status bar says is a menu
   away too. Only the title bar, the menu bar and the content are left. */
QMainWindow > QToolBar, QMainWindow > QStatusBar {
    min-height: 0;
    max-height: 0;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0;
}

/* Toolbars: one module, paper, a light rule along the foot; their buttons
   one module square, the 16px icon in the middle. */
QToolBar {
    qproperty-iconSize: 16px 16px;
    /* The rule along the foot is painted, not a border: a border on a toolbar
       becomes a frame on every side and pushes it off the module. */
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 @paper, stop: 0.966 @paper, stop: 0.967 @rule, stop: 1 @rule);
    border: none;
    padding: 0;
    margin: 0;
    spacing: 0;
}
QToolBar::handle, QToolBar::separator {
    width: 0;
    height: 0;
    image: none;
    background: transparent;
}
/* Tool buttons are pinned to the module (Qt adds a few pixels of its own to a
   styled one): icon buttons 30 x 30 with the 16px icon in the middle, buttons
   with words 30 tall, their words one inset in. */
QToolButton {
    background: transparent;
    color: @ink;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 30px;
    max-height: 30px;
}
QToolButton[toolButtonStyle="0"] {
    min-width: 30px;
    max-width: 30px;
}
QToolButton[toolButtonStyle="1"], QToolButton[toolButtonStyle="2"],
QToolButton[toolButtonStyle="3"], Fm--PathBar QToolButton {
    padding: 0 8px;
}
QToolButton:hover, QToolButton:pressed, QToolButton:checked {
    background: @hover;
    color: @hover-ink;
}
QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* PCManFM-Qt's path bar: its folder buttons are a module tall like any
   other toolbar button. */
Fm--PathBar QToolButton:checked {
    background: @title;
    color: @title-ink;
}

/* Buttons with words, as on the desk: paper with the 1px outline. */
QPushButton {
    background: @paper;
    color: @ink;
    border: 1px solid @outline;
    padding: 0 8px;
    min-height: 28px;
    max-height: 28px;
    min-width: 60px;
}
QPushButton:hover, QPushButton:pressed, QPushButton:checked {
    background: @accent;
    color: @accent-ink;
}
QPushButton:disabled {
    color: @muted-ink;
    border-color: @rule;
}
QPushButton:default {
    border: 1px solid @outline;
}

/* Fields: paper with the 1px outline, one module tall, text one inset in. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @paper;
    color: @ink;
    border: 1px solid @outline;
    padding: 4px 7px;
    selection-background-color: @accent;
    selection-color: @accent-ink;
}
QComboBox::drop-down, QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 28px;
    background: transparent;
}
QComboBox QAbstractItemView {
    background: @paper;
    color: @ink;
    border: 1px solid @outline;
    selection-background-color: @accent;
    selection-color: @accent-ink;
    outline: none;
}

/* The file dialog (laid out by src/style): the file name, the file type and
   the buttons are cells of the strip under the list, parted by light rules
   rather than each outlined. */
Fm--FileDialog QLineEdit#fileName, Fm--FileDialog QComboBox#fileTypeCombo {
    border: none;
    border-top: 1px solid @rule;
    padding: 0 8px;
    min-height: 29px;
    max-height: 29px;
}
Fm--FileDialog QDialogButtonBox QPushButton,
Fm--FileDialog QDialogButtonBox QPushButton:default {
    border: none;
    border-top: 1px solid @rule;
    border-left: 1px solid @rule;
    min-height: 29px;
    max-height: 29px;
}
Fm--FileDialog QDialogButtonBox QPushButton:disabled {
    border-color: @rule;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}
/* Fields in dialogs: rows with a line under each, as in a ledger, rather
   than outlined boxes, which double their outlines where they stack. */
QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    border: none;
    border-bottom: 1px solid @outline;
    padding: 0 8px;
    min-height: 29px;
    max-height: 29px;
}
/* In dialogs, words start one inset in, as in rows and tabs: labels, and
   checkboxes, whose 14px box then sits where an app's square does. */
QDialog QLabel {
    padding: 0 8px;
}
QDialog QCheckBox, QDialog QRadioButton {
    padding-left: 8px;
}

/* Tabs: one module tall and whole modules wide (src/style sizes them; a
   padding or border here would hand their size to the stylesheet, from the
   text), no lines between them, the open one in the title colour. */
QTabWidget::pane {
    border: none;
    border-top: 1px solid @rule;
    top: -1px;
}
QTabBar {
    background: @paper;
}
QTabBar::tab {
    background: @paper;
    color: @ink;
}
QTabBar::tab:selected {
    background: @title;
    color: @title-ink;
}
QTabBar::tab:hover:!selected {
    background: @hover;
}
QTabBar::close-button {
    subcontrol-position: right;
    image: url(@icons/16x16/actions/window-close-symbolic.svg);
    width: 16px;
    height: 16px;
    padding: 7px;
}
QTabBar::close-button:hover {
    background: @hover;
}

/* Lists, trees and tables: paper, rows one module, light rules, the row under
   the pointer washed, the chosen one in the highlight gray. */
QAbstractItemView {
    background: @paper;
    alternate-background-color: @paper;
    color: @ink;
    border: none;
    selection-background-color: @accent;
    selection-color: @accent-ink;
    gridline-color: @rule;
    outline: none;
}
/* What fills a main window (a picture, a text, a page) has no frame of its
   own: the menu bar's rule above it and the window's outline are its edges. */
QMainWindow QAbstractScrollArea {
    border: none;
}
QTreeView::item:hover, QListView::item:hover {
    background: @muted;
}
QTreeView::item:selected, QListView::item:selected {
    background: @accent;
    color: @accent-ink;
}
QHeaderView {
    background: @muted;
    border: none;
}
QHeaderView::section {
    background: @muted;
    color: @ink;
    border: none;
    border-right: 1px solid @rule;
    border-bottom: 1px solid @outline;
    padding: 0 8px;
    height: 29px;
}
/* Row numbers down the side of a table: right-aligned one inset in, a light
   rule under each, the table's outline beside them. */
QHeaderView::section:vertical {
    padding: 0 8px;
    border-right: 1px solid @outline;
    border-bottom: 1px solid @rule;
    color: @muted-ink;
}
QTableView QTableCornerButton::section {
    background: @muted;
    border: none;
    border-right: 1px solid @rule;
    border-bottom: 1px solid @outline;
}

/* The status bar: one module, a light rule along its top. */
QStatusBar {
    background: @paper;
    color: @ink;
    border-top: 1px solid @rule;
}
QStatusBar::item {
    border: none;
}

/* Scroll bars: a one-module gutter (a narrower one would leave what it
   scrolls off the grid) with a light rule along it, and the handle filling
   it, as wide as the gutter, darker under the pointer and while dragged.
   No arrows. */
QScrollBar:vertical {
    background: @paper;
    width: 30px;
    margin: 0;
    border: none;
    border-left: 1px solid @rule;
}
QScrollBar:horizontal {
    background: @paper;
    height: 30px;
    margin: 0;
    border: none;
    border-top: 1px solid @rule;
}
QScrollBar::handle {
    background: @rule;
    border: none;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:hover, QScrollBar::handle:pressed {
    background: @muted-ink;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background: @rule;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

QDockWidget {
    titlebar-close-icon: none;
}
QDockWidget::title {
    background: @muted;
    padding: 5px 8px 4px 8px;
    border-bottom: 1px solid @rule;
}

/* A group is its title, a heading row over what it holds, and no box (whose
   1px frame would set all it holds a pixel off the grid). */
QGroupBox {
    border: none;
    margin-top: 30px;
    padding: 0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 5px 8px;
}

QProgressBar {
    background: @muted;
    border: 1px solid @outline;
    text-align: center;
    min-height: 20px;
}
QProgressBar::chunk {
    background: @hover;
}

/* The calculator (src/calc). The sum on a row of its own, a rule above;
   its result right-aligned under it, muted while it's only a preview, ink
   once it's worked out; the keys drawn by the app in these colours: digits on
   paper, operators on bone, equals in the accent. */
QLineEdit#calcInput {
    border: none;
    border-top: 1px solid @rule;
    /* A field keeps 2px of its own around the text: 6 + 2 is the inset. */
    padding: 0 6px;
    min-height: 29px;
    max-height: 29px;
}
QLabel#calcResult {
    padding: 0 8px;
    color: @muted-ink;
}
QLabel#calcResult[final="true"] {
    color: @ink;
    font-weight: 600;
}
QListWidget#calcHistory {
    border: none;
}
CalcKeypad {
    qproperty-digitColor: @paper;
    qproperty-operatorColor: @muted;
    qproperty-equalsColor: @accent;
    qproperty-equalsInk: @accent-ink;
    qproperty-inkColor: @ink;
    qproperty-ruleColor: @rule;
    qproperty-hoverColor: @hover;
    qproperty-hoverInk: @hover-ink;
    qproperty-pressedColor: @button-hover;
    qproperty-pressedInk: @button-hover-ink;
}
