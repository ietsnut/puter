/* Written by theme/make from theme/qt/puter.qss and theme/palette;
   edit those, not this. */
* {
    outline: none;
}

QToolTip {
    background: #ffffff;
    color: #060606;
    border: 1px solid #060606;
    padding: 0 7px;
    min-height: 28px;
    max-height: 28px;
}

/* The menu bar: paper, each menu's name one inset in, a light rule along its
   foot inside its module. */
QMenuBar {
    background: #ffffff;
    color: #060606;
    border: none;
    border-bottom: 1px solid #d6d1cb;
    padding: 0;
    spacing: 0;
}
QMenuBar::item {
    background: transparent;
}
QMenuBar::item:selected, QMenuBar::item:pressed {
    background: #e0a9df;
    color: #060606;
}

/* Menus: paper with the outline, an item per module, a light rule between
   sections. */
QMenu {
    background: #ffffff;
    color: #060606;
    border: 1px solid #060606;
    padding: 0;
    margin: 0;
}
QMenu::item {
    background: transparent;
}
QMenu::item:selected {
    background: #e0a9df;
    color: #060606;
}
QMenu::item:disabled {
    color: #6b6459;
}
QMenu::separator {
    height: 1px;
    background: #d6d1cb;
    margin: 0;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 8px;
}
QMenu::right-arrow {
    width: 16px;
    height: 16px;
    margin-right: 7px;
}

/* Minimal: no app shows a toolbar or a status bar (apps show them
   regardless of settings, so they are made no height at all). Everything a
   toolbar offers is in the app's menus, and what a status bar says is a menu
   away too. Only the title bar, the menu bar and the content are left. */
QMainWindow > QToolBar, QMainWindow > QStatusBar {
    min-height: 0;
    max-height: 0;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0;
}

/* Toolbars: one module, paper, a light rule along the foot; their buttons
   one module square, the 16px icon in the middle. */
QToolBar {
    qproperty-iconSize: 16px 16px;
    /* The rule along the foot is painted, not a border: a border on a toolbar
       becomes a frame on every side and pushes it off the module. */
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 0.966 #ffffff, stop: 0.967 #d6d1cb, stop: 1 #d6d1cb);
    border: none;
    padding: 0;
    margin: 0;
    spacing: 0;
}
QToolBar::handle, QToolBar::separator {
    width: 0;
    height: 0;
    image: none;
    background: transparent;
}
/* Tool buttons are pinned to the module (Qt adds a few pixels of its own to a
   styled one): icon buttons 30 x 30 with the 16px icon in the middle, buttons
   with words 30 tall, their words one inset in. */
QToolButton {
    background: transparent;
    color: #060606;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 30px;
    max-height: 30px;
}
QToolButton[toolButtonStyle="0"] {
    min-width: 30px;
    max-width: 30px;
}
QToolButton[toolButtonStyle="1"], QToolButton[toolButtonStyle="2"],
QToolButton[toolButtonStyle="3"], Fm--PathBar QToolButton {
    padding: 0 8px;
}
QToolButton:hover, QToolButton:pressed, QToolButton:checked {
    background: #d6d1cb;
    color: #060606;
}
QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* PCManFM-Qt's path bar: its folder buttons are a module tall like any
   other toolbar button. */
Fm--PathBar QToolButton:checked {
    background: #f1f0ec;
    color: #060606;
}

/* Buttons with words, as on the desk: paper with the 1px outline. */
QPushButton {
    background: #ffffff;
    color: #060606;
    border: 1px solid #060606;
    padding: 0 8px;
    min-height: 28px;
    max-height: 28px;
    min-width: 60px;
}
QPushButton:hover, QPushButton:pressed, QPushButton:checked {
    background: #e0a9df;
    color: #060606;
}
QPushButton:disabled {
    color: #6b6459;
    border-color: #d6d1cb;
}
QPushButton:default {
    border: 1px solid #060606;
}

/* Fields: paper with the 1px outline, one module tall, text one inset in. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: #ffffff;
    color: #060606;
    border: 1px solid #060606;
    padding: 4px 7px;
    selection-background-color: #e0a9df;
    selection-color: #060606;
}
QComboBox::drop-down, QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    width: 28px;
    background: transparent;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #060606;
    border: 1px solid #060606;
    selection-background-color: #e0a9df;
    selection-color: #060606;
    outline: none;
}

/* The file dialog (laid out by src/style): the file name, the file type and
   the buttons are cells of the strip under the list, parted by light rules
   rather than each outlined. */
Fm--FileDialog QLineEdit#fileName, Fm--FileDialog QComboBox#fileTypeCombo {
    border: none;
    border-top: 1px solid #d6d1cb;
    padding: 0 8px;
    min-height: 29px;
    max-height: 29px;
}
Fm--FileDialog QDialogButtonBox QPushButton,
Fm--FileDialog QDialogButtonBox QPushButton:default {
    border: none;
    border-top: 1px solid #d6d1cb;
    border-left: 1px solid #d6d1cb;
    min-height: 29px;
    max-height: 29px;
}
Fm--FileDialog QDialogButtonBox QPushButton:disabled {
    border-color: #d6d1cb;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}
/* Fields in dialogs: rows with a line under each, as in a ledger, rather
   than outlined boxes, which double their outlines where they stack. */
QDialog QLineEdit, QDialog QComboBox, QDialog QSpinBox, QDialog QDoubleSpinBox {
    border: none;
    border-bottom: 1px solid #060606;
    padding: 0 8px;
    min-height: 29px;
    max-height: 29px;
}
/* In dialogs, words start one inset in, as in rows and tabs: labels, and
   checkboxes, whose 14px box then sits where an app's square does. */
QDialog QLabel {
    padding: 0 8px;
}
QDialog QCheckBox, QDialog QRadioButton {
    padding-left: 8px;
}

/* Tabs: one module tall and whole modules wide (src/style sizes them; a
   padding or border here would hand their size to the stylesheet, from the
   text), no lines between them, the open one in the title colour. */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #d6d1cb;
    top: -1px;
}
QTabBar {
    background: #ffffff;
    /* No base line of its own: the rule above (the menu bar's) is the only
       one, where the base style drew a second, in a gray of its own. */
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: #ffffff;
    color: #060606;
}
QTabBar::tab:selected {
    background: #f1f0ec;
    color: #060606;
}
QTabBar::tab:hover:!selected {
    background: #d6d1cb;
}
/* A tab's close button: a one-module square at its right end, the 16px
   glyph in its middle (width and height hold the padding, so the glyph gets
   what's left: 30 - 2 x 7). */
QTabBar::close-button {
    subcontrol-position: right;
    image: url(@icons/16x16/actions/window-close-symbolic.svg);
    width: 30px;
    height: 30px;
    padding: 7px;
}
QTabBar::close-button:hover {
    background: #d6d1cb;
}

/* Lists, trees and tables: paper, rows one module, light rules, the row under
   the pointer washed, the chosen one in the highlight gray. */
QAbstractItemView {
    background: #ffffff;
    alternate-background-color: #ffffff;
    color: #060606;
    border: none;
    selection-background-color: #e0a9df;
    selection-color: #060606;
    gridline-color: #d6d1cb;
    outline: none;
}
/* What fills a main window (a picture, a text, a page) has no frame of its
   own: the menu bar's rule above it and the window's outline are its edges. */
QMainWindow QAbstractScrollArea {
    border: none;
}
QTreeView::item:hover, QListView::item:hover {
    background: #f1f0ec;
}
QTreeView::item:selected, QListView::item:selected {
    background: #e0a9df;
    color: #060606;
}
QHeaderView {
    background: #f1f0ec;
    border: none;
}
QHeaderView::section {
    background: #f1f0ec;
    color: #060606;
    border: none;
    border-right: 1px solid #d6d1cb;
    border-bottom: 1px solid #060606;
    padding: 0 8px;
    height: 29px;
}
/* Row numbers down the side of a table: right-aligned one inset in, a light
   rule under each, the table's outline beside them. */
QHeaderView::section:vertical {
    padding: 0 8px;
    border-right: 1px solid #060606;
    border-bottom: 1px solid #d6d1cb;
    color: #6b6459;
}
QTableView QTableCornerButton::section {
    background: #f1f0ec;
    border: none;
    border-right: 1px solid #d6d1cb;
    border-bottom: 1px solid #060606;
}

/* The status bar: one module, a light rule along its top. */
QStatusBar {
    background: #ffffff;
    color: #060606;
    border-top: 1px solid #d6d1cb;
}
QStatusBar::item {
    border: none;
}

/* Scroll bars: a one-module gutter (a narrower one would leave what it
   scrolls off the grid) with a light rule along it, and the handle filling
   it, as wide as the gutter, darker under the pointer and while dragged.
   No arrows. */
QScrollBar:vertical {
    background: #ffffff;
    width: 30px;
    margin: 0;
    border: none;
    border-left: 1px solid #d6d1cb;
}
QScrollBar:horizontal {
    background: #ffffff;
    height: 30px;
    margin: 0;
    border: none;
    border-top: 1px solid #d6d1cb;
}
QScrollBar::handle {
    background: #d6d1cb;
    border: none;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:hover, QScrollBar::handle:pressed {
    background: #6b6459;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background: #d6d1cb;
}
QSplitter::handle:horizontal {
    width: 1px;
}
QSplitter::handle:vertical {
    height: 1px;
}

QDockWidget {
    titlebar-close-icon: none;
}
QDockWidget::title {
    background: #f1f0ec;
    padding: 5px 8px 4px 8px;
    border-bottom: 1px solid #d6d1cb;
}

/* A group is its title, a heading row over what it holds, and no box (whose
   1px frame would set all it holds a pixel off the grid). */
QGroupBox {
    border: none;
    margin-top: 30px;
    padding: 0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    padding: 5px 8px;
}

QProgressBar {
    background: #f1f0ec;
    border: 1px solid #060606;
    text-align: center;
    min-height: 20px;
}
QProgressBar::chunk {
    background: #d6d1cb;
}

/* The calculator (src/calc). The sum on a row of its own, a rule above;
   its result right-aligned under it, muted while it's only a preview, ink
   once it's worked out; the keys drawn by the app in these colours: digits on
   paper, operators on bone, equals in the accent. */
QLineEdit#calcInput {
    border: none;
    border-top: 1px solid #d6d1cb;
    /* A field keeps 2px of its own around the text: 6 + 2 is the inset. */
    padding: 0 6px;
    min-height: 29px;
    max-height: 29px;
}
QLabel#calcResult {
    padding: 0 8px;
    color: #6b6459;
}
QLabel#calcResult[final="true"] {
    color: #060606;
    font-weight: 600;
}
QListWidget#calcHistory {
    border: none;
}
CalcKeypad {
    qproperty-digitColor: #ffffff;
    qproperty-operatorColor: #f1f0ec;
    qproperty-equalsColor: #e0a9df;
    qproperty-equalsInk: #060606;
    qproperty-inkColor: #060606;
    qproperty-ruleColor: #d6d1cb;
    qproperty-hoverColor: #d6d1cb;
    qproperty-hoverInk: #060606;
    qproperty-pressedColor: #4a4446;
    qproperty-pressedInk: #ffffff;
}
