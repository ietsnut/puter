# puter's palette: Apollo (AdamCYounis, lospec.com/palette-list/apollo).
# Roles on the left, Apollo colours on the right; `theme/make` writes every
# app's colours from this file. Change a line here, run it, and dev/sync.

desk        blue5    # behind the windows
paper       gray9    # windows, the bar, panels
ink         green0   # text, the search square, inputs, menus
accent      green4   # the focused title bar, the active tab, selections
accent-ink  green0   # text and icons on the accent
muted       gray7    # unfocused title bars and tabs
muted-ink   gray4    # text and icons on muted

